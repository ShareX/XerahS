<Project>
  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />
  <PropertyGroup>
    <Version>0.31.5</Version>
    <Product>XerahS</Product>
    <Authors>ShareX Team</Authors>
    <Company>ShareX Team</Company>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
    <!-- Compile/test lanes stay side-effect free. Product lanes opt in explicitly. -->
    <AssembleProduct Condition="'$(AssembleProduct)' == ''">false</AssembleProduct>
    <BuildWebUI Condition="'$(BuildWebUI)' == ''">$(AssembleProduct)</BuildWebUI>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3026</MSBuildWarningsAsMessages>
    <!-- Workaround for Fedora .NET package missing prune data -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <CrossCompile>true</CrossCompile>
  </PropertyGroup>
</Project>
