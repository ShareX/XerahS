<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Must stay aligned with the ShareX.* namespaces in code. Avalonia compiled XAML resolves plugin views against RootNamespace, and changing this to XerahS.* breaks config views at runtime. -->
    <RootNamespace>ShareX.Imgur.Plugin</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Plugin metadata -->
  <PropertyGroup>
    <PluginId>imgur</PluginId>
    <PluginName>Imgur Uploader</PluginName>

  </PropertyGroup>

  <!-- Avalonia packages for UI - use exact versions from main app -->
  <!-- Mark as ExcludeAssets=runtime so they are NOT copied to plugin output (use host's versions) -->
  <ItemGroup>
    <PackageReference Include="Avalonia">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Themes.Fluent">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Controls.DataGrid">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Reference host assemblies (don't copy, use host's version) -->
  <ItemGroup>
    <ProjectReference Include="..\..\core\XerahS.Uploaders\XerahS.Uploaders.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\core\XerahS.Common\XerahS.Common.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Include plugin.json in output -->
  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
