<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.KovaForge.Plugin.ViewModels"
             x:Class="ShareX.KovaForge.Plugin.Views.KovaForgeConfigView"
             x:DataType="vm:KovaForgeConfigViewModel">

    <UserControl.Styles>
        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
            <Border Classes="heroCard">
                <StackPanel Spacing="8">
                    <TextBlock Text="KovaForge Docs"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="Upload text, Markdown, images, and files to KovaForge and copy a link. Anyone with the link can open it until you revoke it on kovaforge.org/docs."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               MaxWidth="680"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Connection"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Server URL *"/>
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="https://kovaforge.org"/>
                        <TextBlock Classes="helper"
                                   Text="The KovaForge address. Uploads go to /docs/api/upload on this server."/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Upload Token *"/>
                        <TextBox Text="{Binding ApiToken, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="Stored securely in the secret store"/>
                        <TextBlock Classes="helper" Text="{Binding TokenSummary}"/>
                        <TextBlock Classes="helper"
                                   Text="Create a token on kovaforge.org/docs under Upload tokens. It is shown once. Revoke it there if this device is lost."/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding TextAsMarkdown}"
                              Content="Upload text as Markdown (.md) so it is shown as a formatted page"/>

                    <Button Content="Clear Stored Token"
                            Command="{Binding ClearStoredTokenCommand}"
                            HorizontalAlignment="Left"/>

                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Status" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
