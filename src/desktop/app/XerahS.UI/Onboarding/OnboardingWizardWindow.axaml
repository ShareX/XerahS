<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XerahS.UI.Onboarding"
        xmlns:theming="clr-namespace:XerahS.UI.Theming"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="460"
        x:Class="XerahS.UI.Onboarding.OnboardingWizardWindow"
        x:DataType="vm:OnboardingWizardViewModel"
        Title="Welcome to XerahS"
        Width="600"
        Height="460"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        CanResize="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Window.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
    <Style Selector="Border.step-icon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.step-icon > TextBlock">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.setting-row">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
  </Window.Styles>
  <Design.DataContext>
    <vm:OnboardingWizardViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="*,Auto" Margin="24">
    <Border Grid.Row="0"
            Classes="section-card"
            Padding="24"
            Margin="0,0,0,16"
            AutomationProperties.LandmarkType="Main">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

          <!-- Step 1: theme -->
          <StackPanel Spacing="20" IsVisible="{Binding IsThemeStep}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border Classes="step-icon">
                <TextBlock Classes="IconGlyph" Text="{x:Static theming:HostIcons.OnboardingTheme}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Welcome to XerahS"
                           Classes="section-header"
                           AutomationProperties.HeadingLevel="1" />
                <TextBlock Text="Pick how XerahS looks. You can change this later in Application Settings."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
              <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="Follow system theme" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1"
                                OnContent="" OffContent=""
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Follow system theme"
                                IsChecked="{Binding UseSystemTheme, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Classes="setting-row" IsVisible="{Binding CanChooseTheme}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            Width="160"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Theme"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:OnboardingThemeOption">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Steps 2+: where to configure things -->
          <ContentControl Content="{Binding CurrentAdvice}" IsVisible="{Binding !IsThemeStep}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:OnboardingAdvice">
                <StackPanel Spacing="20">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Classes="step-icon">
                      <TextBlock Classes="IconGlyph" Text="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}"
                                 Classes="section-header"
                                 AutomationProperties.HeadingLevel="1" />
                      <TextBlock Text="{Binding Subtitle}"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </Grid>

                  <Border Classes="setting-row">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Where to go"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      <TextBlock Text="{Binding Location}"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <ItemsControl ItemsSource="{Binding Tips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="16,*">
                          <TextBlock Text="•" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Button Grid.Column="0"
              Content="Back"
              Command="{Binding BackCommand}"
              Classes="WizardGhostButton"
              IsVisible="{Binding CanGoBack}" />
      <TextBlock Grid.Column="1"
                 Text="{Binding StepCounterText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <Button Grid.Column="2"
              Content="OK"
              MinWidth="96"
              IsDefault="True"
              Command="{Binding OkCommand}"
              Classes="WizardPrimaryButton" />
    </Grid>
  </Grid>
</Window>
