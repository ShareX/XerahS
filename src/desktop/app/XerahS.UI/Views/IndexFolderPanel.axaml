<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:local="using:XerahS.UI.Markup"
             mc:Ignorable="d" 
             d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="XerahS.UI.Views.IndexFolderPanel"
             x:DataType="vm:IndexFolderViewModel">

    <Design.DataContext>
        <vm:IndexFolderViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            Padding="24">
        <Grid RowDefinitions="Auto,*"
              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                <TextBlock Text="{local:Localize IndexFolder_Title}" Theme="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Main Content -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="400, *"
                  ColumnSpan="2"
                  Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <!-- Left Column: Settings -->
                <ScrollViewer Grid.Column="0"
                              Padding="0,0,24,0"
                              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                              AllowAutoHide="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible">
                    <StackPanel Spacing="16">
                    
                    <!-- Folder Selection Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{local:Localize IndexFolder_Folder}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding FolderPath}" PlaceholderText="{local:Localize IndexFolder_PlaceholderSelectFolder}"
                                         AutomationProperties.Name="Folder Path"/>
                                <Button Grid.Column="1" Content="{local:Localize IndexFolder_Browse}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"
                                        MinWidth="90"
                                        Classes="accent"
                                        AutomationProperties.Name="Browse Folder"/>
                            </Grid>
                            <TextBlock Text="{Binding FolderPathError}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       IsVisible="{Binding HasFolderPathError}"/>
                        </StackPanel>
                    </Border>

                    <!-- Output Options Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{local:Localize IndexFolder_OutputConfiguration}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            
                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="12" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize IndexFolder_FormatLabel}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding IndexerOutputs}" SelectedItem="{Binding Output}" 
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Output Format"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Localize IndexFolder_MaxDepthLabel}" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxDepthLevel}" Minimum="0" Maximum="50" 
                                               HorizontalAlignment="Stretch" AutomationProperties.Name="Max Depth Level"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Filters Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{local:Localize IndexFolder_FiltersMetadata}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <CheckBox IsChecked="{Binding SkipHiddenFolders}" Content="{local:Localize IndexFolder_SkipHiddenFolders}" AutomationProperties.Name="Skip Hidden Folders"/>
                            <CheckBox IsChecked="{Binding SkipHiddenFiles}" Content="{local:Localize IndexFolder_SkipHiddenFiles}" AutomationProperties.Name="Skip Hidden Files"/>
                            <CheckBox IsChecked="{Binding SkipFiles}" Content="{local:Localize IndexFolder_SkipFiles}" AutomationProperties.Name="Skip Files"/>
                            <CheckBox IsChecked="{Binding IgnoreEmptyFolders}" Content="{local:Localize IndexFolder_IgnoreEmptyFolders}" AutomationProperties.Name="Ignore Empty Folders"/>
                            <CheckBox IsChecked="{Binding ShowSizeInfo}" Content="{local:Localize IndexFolder_IncludeSizeInfo}" AutomationProperties.Name="Include Size Info"/>
                            <CheckBox IsChecked="{Binding BinaryUnits}" Content="{local:Localize IndexFolder_BinaryUnits}" AutomationProperties.Name="Use Binary Units"/>
                            <CheckBox IsChecked="{Binding AddFooter}" Content="{local:Localize IndexFolder_AddFooter}" AutomationProperties.Name="Add Footer"/>
                        </StackPanel>
                    </Border>

                    <!-- File Extension Filters Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{local:Localize IndexFolder_FileExtensionFilters}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{local:Localize IndexFolder_IncludeOnlyLabel}" FontSize="12" Opacity="0.8"/>
                                <TextBox Text="{Binding IncludedFileExtensionsText}" PlaceholderText="{local:Localize IndexFolder_IncludePlaceholder}"
                                         AutomationProperties.Name="Included File Extensions"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{local:Localize IndexFolder_ExcludeLabel}" FontSize="12" Opacity="0.8"/>
                                <TextBox Text="{Binding ExcludedFileExtensionsText}" PlaceholderText="{local:Localize IndexFolder_ExcludePlaceholder}"
                                         AutomationProperties.Name="Excluded File Extensions"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Text Formatting Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{local:Localize IndexFolder_TextFormatting}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{local:Localize IndexFolder_IndentationLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding IndentationText}" AutomationProperties.Name="Indentation Text"/>
                            </Grid>
                            <CheckBox IsChecked="{Binding AddEmptyLineAfterFolders}" Content="{local:Localize IndexFolder_AddEmptyLineAfterFolders}" AutomationProperties.Name="Add Empty Line After Folders"/>
                        </StackPanel>
                    </Border>

                    <!-- HTML Options Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{local:Localize IndexFolder_HtmlOptions}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <CheckBox IsChecked="{Binding UseCustomCssFile}" Content="{local:Localize IndexFolder_UseCustomCss}" AutomationProperties.Name="Use Custom CSS"/>
                            <Grid ColumnDefinitions="*, Auto" IsEnabled="{Binding UseCustomCssFile}">
                                <TextBox Grid.Column="0" Text="{Binding CustomCssFilePath}" PlaceholderText="{local:Localize IndexFolder_CssPathPlaceholder}"
                                         AutomationProperties.Name="Custom CSS Path"/>
                                <Button Grid.Column="1" Content="{local:Localize IndexFolder_Browse}" Command="{Binding BrowseCssCommand}" Margin="8,0,0,0"
                                        MinWidth="90"
                                        Classes="accent"
                                        AutomationProperties.Name="Browse CSS File"/>
                            </Grid>
                            <CheckBox IsChecked="{Binding DisplayPath}" Content="{local:Localize IndexFolder_DisplayPath}" AutomationProperties.Name="Display Path for Subfolders"/>
                            <CheckBox IsChecked="{Binding DisplayPathLimited}" Content="{local:Localize IndexFolder_DisplayPathLimited}" IsEnabled="{Binding DisplayPath}" Margin="24,0,0,0"
                                      AutomationProperties.Name="Limit Display Path"/>
                        </StackPanel>
                    </Border>

                    <!-- Structured Data Card -->
                    <Border Theme="{StaticResource CardBorderTheme}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{local:Localize IndexFolder_XmlJsonOptions}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <CheckBox IsChecked="{Binding UseAttribute}" Content="{local:Localize IndexFolder_UseAttribute}" AutomationProperties.Name="XML Attributes"/>
                            <CheckBox IsChecked="{Binding CreateParseableJson}" Content="{local:Localize IndexFolder_ParseableJson}" AutomationProperties.Name="Parseable JSON"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Preview & Actions -->
                <Grid Grid.Column="1"
                      RowDefinitions="Auto, Auto, *"
                      Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                
                <!-- Action Bar -->
                <Border Grid.Row="0" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{local:Localize IndexFolder_PreviewActions}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{Binding PrimaryActionLabel}" Command="{Binding IndexFolderCommand}" 
                                    IsEnabled="{Binding CanStartIndexing}" AutomationProperties.Name="Generate Index"/>
                            <Button Content="{local:Localize IndexFolder_Cancel}" Command="{Binding CancelIndexingCommand}" 
                                    IsEnabled="{Binding CanCancelIndexing}" AutomationProperties.Name="Cancel Indexing"/>
                            <Button Content="{local:Localize IndexFolder_OpenInBrowser}" Command="{Binding RenderHtmlPreviewCommand}" 
                                    IsEnabled="{Binding CanRenderHtml}" AutomationProperties.Name="Open HTML in Browser"/>
                            <Button Content="{local:Localize IndexFolder_Copy}" Command="{Binding CopyOutputCommand}" 
                                    IsEnabled="{Binding HasOutput}" AutomationProperties.Name="Copy Output"/>
                            <Button Content="{local:Localize IndexFolder_SaveAs}" Command="{Binding SaveAsCommand}" 
                                    IsEnabled="{Binding CanSave}" IsVisible="{Binding ShowSave}" AutomationProperties.Name="Save Output"/>
                            <Button Content="{local:Localize IndexFolder_Upload}" Command="{Binding UploadCommand}" 
                                    IsEnabled="{Binding CanUpload}" IsVisible="{Binding ShowUpload}" AutomationProperties.Name="Upload Output"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress -->
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,0,0,16" IsVisible="{Binding IsBusy}"/>

                <!-- Text Output -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <TextBox Text="{Binding OutputText}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 BorderThickness="0"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 AutomationProperties.Name="Output Preview"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
