<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:local="using:XerahS.UI.Markup"
        mc:Ignorable="d" d:DesignWidth="680"
        x:Class="XerahS.UI.Views.ShareLogsDialog"
        x:DataType="vm:ShareLogsViewModel"
        Width="680">

    <!-- Hosted in the main window's ModalContent overlay (IViewDialogService.ShowShareLogsAsync),
         which supplies the backdrop, card chrome and scrolling. -->
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            Padding="24">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{local:Localize ShareLogs_Title}" Theme="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="{local:Localize ShareLogs_Subtitle}"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Privacy disclosure -->
            <Border Theme="{StaticResource CardBorderTheme}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="{local:Localize ShareLogs_WhatShared}" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_Logs}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_App}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_System}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_Hardware}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_Monitors}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_Recording}"/>
                    <TextBlock TextWrapping="Wrap" Text="{local:Localize ShareLogs_Item_Id}"/>

                    <TextBlock Text="{local:Localize ShareLogs_NeverShared}" Theme="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{local:Localize ShareLogs_NeverSharedText}"/>
                </StackPanel>
            </Border>

            <!-- Time range -->
            <Border Theme="{StaticResource CardBorderTheme}" Padding="20">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{local:Localize ShareLogs_History}" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding WindowLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1" TickFrequency="1"
                            IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                            Value="{Binding WindowIndex}"
                            AutomationProperties.Name="Log history to include"/>
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Text="{local:Localize ShareLogs_Past24h}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{local:Localize ShareLogs_PastWeek}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <ProgressBar IsIndeterminate="True" Width="48" VerticalAlignment="Center"
                                     IsVisible="{Binding IsPreparing}"/>
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AlreadySentText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding AlreadySentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!-- Optional note -->
            <StackPanel Spacing="6">
                <TextBlock Text="{local:Localize ShareLogs_WhatHappened}" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="72" MaxLength="2000"
                         PlaceholderText="{local:Localize ShareLogs_WhatHappenedHint}"
                         AutomationProperties.Name="What happened"/>
            </StackPanel>

            <!-- Exact payload -->
            <Expander Header="{local:Localize ShareLogs_Review}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBox Text="{Binding PreviewText}" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="monospace" FontSize="12" Height="280" AcceptsReturn="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Report preview"/>
                    <Button Content="{local:Localize ShareLogs_SaveCopy}" Command="{Binding SaveCopyCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Save a copy of the report"/>
                </StackPanel>
            </Expander>

            <!-- Status and actions -->
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Classes.error="{Binding StatusIsError}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock.error">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </Style>
                </TextBlock.Styles>
            </TextBlock>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Content="{local:Localize ShareLogs_CopyId}" Command="{Binding CopyReportIdCommand}"
                        IsVisible="{Binding HasSentReport}"
                        AutomationProperties.Name="Copy report ID"/>
                <Button Grid.Column="1" Content="{local:Localize ShareLogs_DeleteLast}" Command="{Binding DeleteLastReportCommand}"
                        IsVisible="{Binding HasSentReport}"
                        AutomationProperties.Name="Delete the last report sent from this computer"/>
                <Button Grid.Column="3" Content="{local:Localize AfterUpload_Close}" Command="{Binding CloseCommand}" MinWidth="88"
                        IsCancel="True"
                        AutomationProperties.Name="Close"/>
                <Button Grid.Column="4" Content="{local:Localize ShareLogs_Send}" Command="{Binding SendCommand}" MinWidth="88"
                        IsDefault="True"
                        AutomationProperties.Name="Send logs"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
