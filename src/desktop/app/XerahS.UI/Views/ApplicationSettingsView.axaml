<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:viewcontrols="using:XerahS.UI.Views.Controls"
                xmlns:vm="using:XerahS.UI.ViewModels"
                xmlns:controls="using:XerahS.UI.Controls"
                xmlns:converters="using:XerahS.UI.Converters"
                x:Class="XerahS.UI.Views.ApplicationSettingsView"
                x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <views:PageView.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </views:PageView.Resources>

    <Grid RowDefinitions="Auto, *"
          Margin="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <TabControl Grid.Row="1"
                    x:Name="ApplicationSettingsTabs"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer controls:SettingsSearch.PageId="general">
                    <StackPanel Spacing="24" Margin="24">
                        
                        <!-- Theme -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Theme" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="Application Theme:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding ThemeModes}"
                                                  SelectedItem="{Binding ThemeMode}"
                                                  MinWidth="200"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Application Theme"/>
                                    </Grid>
                                    <TextBlock Text="'System default' follows your operating system's light/dark mode preference."
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Updates -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Updates" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding AutoCheckUpdate}" Content="Automatically check for updates" AutomationProperties.Name="Auto Check Update"/>
                                    
                                    <Grid ColumnDefinitions="*, 16, *" RowDefinitions="Auto, 12, Auto">
                                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, 16, *">
                                            <TextBlock Grid.Column="0" Text="Update channel:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding UpdateChannels}"
                                                      SelectedItem="{Binding UpdateChannel}"
                                                      IsEnabled="{Binding AutoCheckUpdate}"
                                                      HorizontalAlignment="Stretch" MinWidth="160"
                                                      AutomationProperties.Name="Update Channel"/>
                                        </Grid>

                                        <Grid Grid.Column="2" Grid.Row="0"
                                              ColumnDefinitions="Auto, 16, *"
                                              IsVisible="{Binding ShowPreReleaseSourceSettings}">
                                            <TextBlock Grid.Column="0" Text="Pre-release source:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding PreReleaseUpdateSources}"
                                                      SelectedItem="{Binding PreReleaseUpdateSource}"
                                                      IsEnabled="{Binding AutoCheckUpdate}"
                                                      HorizontalAlignment="Stretch" MinWidth="160"
                                                      AutomationProperties.Name="Pre-release Source">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Grid.Column="2" Grid.Row="2"
                                              ColumnDefinitions="Auto, 16, *"
                                              IsVisible="{Binding ShowCustomPreReleaseSource}">
                                            <TextBlock Grid.Column="0" Text="Custom source:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding CustomPreReleaseUpdateSource}"
                                                     PlaceholderText="GitHub owner or owner/repo"
                                                     IsEnabled="{Binding AutoCheckUpdate}"
                                                     HorizontalAlignment="Stretch" MinWidth="160"
                                                     AutomationProperties.Name="Custom Pre-release Source"/>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Text="Release checks ShareX/XerahS. PreRelease checks the selected source; KovaForge/XerahS contains this fork's development builds. Versions and availability can differ between repositories."
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <Button Grid.Column="0"
                                                Content="{Binding ManualUpdateButtonText}"
                                                Command="{Binding ManualUpdateCommand}"
                                                IsEnabled="{Binding CanTriggerManualUpdate}"
                                                MinWidth="120"
                                                AutomationProperties.Name="Update Now"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ManualUpdateStatusText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Notifications -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding DisableToastNotification}"
                                              Content="Disable notification window"
                                              ToolTip.Tip="Suppress the corner toast popup that normally appears after a task completes (e.g. 'Task Completed', 'Upload Completed'). Capture, upload and other actions still run normally."
                                              AutomationProperties.Name="Disable Notification Window"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Tray Icon -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Tray Icon" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding TrayIconProgressEnabled}" Content="Show progress on tray icon" AutomationProperties.Name="Show Tray Progress"/>
                                    <CheckBox IsChecked="{Binding UseWhiteShareXIcon}"
                                              Content="Use single-color white tray icon"
                                              ToolTip.Tip="Use the simple monochrome outline tray icon instead of the full-color one. Recommended on macOS and Linux where system panels are dark; opt-in on Windows. On GNOME, requires the AppIndicator extension."
                                              AutomationProperties.Name="Use White Tray Icon"/>
                                    
                                    <TextBlock Text="Click Actions" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>

                                    <Grid ColumnDefinitions="120, 16, *" RowDefinitions="Auto, 16, Auto, 16, Auto">
                                        <!-- Row 0: Left Click -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left click:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="2" 
                                                  ItemsSource="{Binding TrayClickActions}"
                                                  SelectedItem="{Binding TrayLeftClickAction}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tray Left Click Action"/>

                                        <!-- Row 2: Double Click -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Double click:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="2" 
                                                  ItemsSource="{Binding TrayClickActions}"
                                                  SelectedItem="{Binding TrayLeftDoubleClickAction}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tray Double Click Action"/>

                                        <!-- Row 4: Middle Click -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Middle click:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="4" Grid.Column="2" 
                                                  ItemsSource="{Binding TrayClickActions}"
                                                  SelectedItem="{Binding TrayMiddleClickAction}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tray Middle Click Action"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Taskbar -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Taskbar" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <CheckBox IsChecked="{Binding TaskbarProgressEnabled}" Content="Show progress on taskbar" AutomationProperties.Name="Show Taskbar Progress"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Paths Tab -->
            <TabItem Header="Paths">
                <ScrollViewer controls:SettingsSearch.PageId="paths">
                    <StackPanel Spacing="24" Margin="24">
                         <!-- Screenshots Folder -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Screenshots Folder" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseCustomScreenshotsPath}" Content="Use custom screenshots path" AutomationProperties.Name="Use Custom Screenshots Path"/>
                                    <Grid ColumnDefinitions="*, 16, Auto" IsEnabled="{Binding UseCustomScreenshotsPath}">
                                        <TextBox Grid.Column="0" Text="{Binding ScreenshotsFolder}" PlaceholderText="Path to screenshots folder" AutomationProperties.Name="Screenshots Folder Path"/>
                                        <Button Grid.Column="2"
                                                Width="36"
                                                MinWidth="36"
                                                Padding="0"
                                                Content="..."
                                                ToolTip.Tip="Browse for screenshots folder"
                                                Command="{Binding BrowseFolderCommand}"
                                                AutomationProperties.Name="Browse Screenshots Folder"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Subfolder Pattern -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Subfolder Pattern" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseSaveImageSubFolderPattern}" Content="Create subfolders using pattern" AutomationProperties.Name="Use Subfolder Pattern"/>
                                    <Grid ColumnDefinitions="Auto, 16, *" IsEnabled="{Binding UseSaveImageSubFolderPattern}">
                                        <TextBlock Grid.Column="0" Text="Pattern:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SaveImageSubFolderPatternTextBox" Grid.Column="2" Text="{Binding SaveImageSubFolderPattern}" PlaceholderText="%y-%mo" AutomationProperties.Name="Subfolder Pattern"/>
                                    </Grid>
                                    <TextBlock Text="Example: 2025-01" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Watch Folders Tab -->
            <TabItem Header="Watch Folders">
                <ScrollViewer controls:SettingsSearch.PageId="watch-folders">
                    <StackPanel Spacing="24" Margin="24">
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Watch folders" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Monitor folders for new files and run file upload workflows automatically."
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="*, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="Configured folders" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Add" Command="{Binding AddWatchFolderCommand}" AutomationProperties.Name="Add Watch Folder"/>
                                            <Button Content="Edit" Command="{Binding EditWatchFolderCommand}" AutomationProperties.Name="Edit Watch Folder"/>
                                            <Button Content="Remove" Command="{Binding RemoveWatchFolderCommand}" AutomationProperties.Name="Remove Watch Folder"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Watch Folder List Header -->
                                    <Grid ColumnDefinitions="80, 90, 2*, 150, 120, 120, 150, 120" Margin="4,0,4,0">
                                        <TextBlock Grid.Column="0" Text="Enabled" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="Folder" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="Workflow" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="Filter" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="Subfolders" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="6" Text="Move to Screenshots" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="7" Text="MOV to MP4" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>

                                    <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="4">
                                        <ListBox ItemsSource="{Binding WatchFolders}"
                                                 SelectedItem="{Binding SelectedWatchFolder}"
                                                 MinHeight="140"
                                                 AutomationProperties.Name="Watch Folders List">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WatchFolderSettingsViewModel">
                                                    <Grid ColumnDefinitions="80, 90, 2*, 150, 120, 120, 150, 120" Margin="6">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enable Watch Folder"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusDetail}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FolderPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderPath}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding WorkflowName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkflowName}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Filter}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding IncludeSubdirectoriesText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding MoveFilesToScreenshotsFolderText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding ConvertMovToMp4BeforeProcessingText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Watch Folder Service/Daemon" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Run watch-folder monitoring in a dedicated background service/daemon using your existing settings."
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="Auto, 16, *"
                                          IsVisible="{Binding ShowWatchFolderDaemonScopeSelector}">
                                        <TextBlock Grid.Column="0" Text="Scope:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding WatchFolderDaemonScopes}"
                                                  SelectedItem="{Binding WatchFolderDaemonScope}"
                                                  MinWidth="180"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Watch Folder Daemon Scope"/>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding WatchFolderDaemonStartAtStartup}"
                                              Content="Start daemon at startup"
                                              AutomationProperties.Name="Watch Folder Daemon Startup"/>

                                    <Grid ColumnDefinitions="*, 12, Auto, 8, Auto"
                                          VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding WatchFolderDaemonStatusText}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding WatchFolderDaemonLastError}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Refresh"
                                                Command="{Binding RefreshWatchFolderDaemonStatusCommand}"
                                                AutomationProperties.Name="Refresh Watch Folder Daemon Status"/>

                                        <Button Grid.Column="4"
                                                Content="{Binding WatchFolderDaemonButtonText}"
                                                Command="{Binding ToggleWatchFolderDaemonCommand}"
                                                IsEnabled="{Binding WatchFolderDaemonSupported}"
                                                AutomationProperties.Name="Toggle Watch Folder Daemon"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Integration Tab -->
            <TabItem Header="Integration">
                <ScrollViewer controls:SettingsSearch.PageId="integration">
                    <StackPanel Spacing="24" Margin="24">
                        <!-- System -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="System" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding ShowTray}" Content="Show tray icon" AutomationProperties.Name="Show Tray Icon"/>
                                    <CheckBox IsChecked="{Binding SilentRun}" Content="Start minimized to tray"
                                              IsEnabled="{Binding ShowTray}" AutomationProperties.Name="Start Minimized"/>
                                    <CheckBox IsChecked="{Binding RememberMainWindowSize}"
                                              Content="Remember main window size"
                                              AutomationProperties.Name="Remember Main Window Size"/>
                                    <CheckBox IsChecked="{Binding RememberMainWindowPosition}"
                                              Content="Remember main window position"
                                              AutomationProperties.Name="Remember Main Window Position"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Desktop Integration -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Desktop Integration" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding RunAtStartup}" 
                                              Content="Run at system startup" AutomationProperties.Name="Run at Startup"/>
                                    <CheckBox IsChecked="{Binding NetworkMonitorEnabled}"
                                              Content="Run Network Monitor in the background"
                                              ToolTip.Tip="Periodically pings external hosts to monitor connectivity, including at startup. Disabled by default. You can also use Tools > Network Monitor for a temporary session."
                                              AutomationProperties.Name="Background Network Monitor"/>
                                    <CheckBox IsChecked="{Binding EnableContextMenuIntegration}" 
                                              Content="Add 'Upload with XerahS' to context menu"
                                              IsEnabled="{Binding SupportsContextMenuIntegration}"
                                              ToolTip.Tip="Adds an option to upload files from the right-click context menu"
                                              AutomationProperties.Name="Enable Context Menu Integration"/>
                                    <CheckBox IsChecked="{Binding EnableSendToIntegration}" 
                                              Content="Add to 'Send To' menu"
                                              IsEnabled="{Binding SupportsSendToIntegration}"
                                              ToolTip.Tip="Adds XerahS to the 'Send To' menu for quick file access"
                                              AutomationProperties.Name="Enable Send To Integration"/>

                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Send-to defaults"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>
                                            <TextBlock Text="These defaults apply to the Send-to prompt. Remembered choices still win when the selection matches a stored scope. Upload with XerahS is unaffected."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Folder policy"
                                                       FontSize="11"/>
                                            <ComboBox ItemsSource="{Binding SendToFolderPolicyOptions}"
                                                      SelectedIndex="{Binding SendToFolderPolicySelectedIndex}"
                                                      MinWidth="220"
                                                      HorizontalAlignment="Left"
                                                      AutomationProperties.Name="Send To Folder Policy"/>
                                            <TextBlock Text="Image batch policy"
                                                       FontSize="11"/>
                                            <ComboBox ItemsSource="{Binding SendToBatchPolicyOptions}"
                                                      SelectedIndex="{Binding SendToBatchPolicySelectedIndex}"
                                                      MinWidth="220"
                                                      HorizontalAlignment="Left"
                                                      AutomationProperties.Name="Send To Batch Policy"/>
                                            <NumericUpDown Value="{Binding SendToBatchConfirmThreshold}"
                                                           Minimum="1"
                                                           Maximum="100"
                                                           Increment="1"
                                                           MinWidth="120"
                                                           HorizontalAlignment="Left"
                                                           IsVisible="{Binding ShowSendToBatchThreshold}"
                                                           AutomationProperties.Name="Send To Batch Confirm Threshold"/>
                                            <TextBlock Text="Send-to remembered choices"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding RememberedSendToChoicesSummary}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="Clear remembered Send-to choices"
                                                    Command="{Binding ClearRememberedSendToChoicesCommand}"
                                                    IsEnabled="{Binding HasRememberedSendToChoices}"
                                                    HorizontalAlignment="Left"
                                                    AutomationProperties.Name="Clear Remembered Send To Choices"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Clipboard" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>

                                    <CheckBox IsChecked="{Binding EnableClipboardContentViewer}"
                                              Content="Monitor clipboard and auto-show Clipboard Viewer"
                                              ToolTip.Tip="When enabled, automatically opens the Clipboard Viewer when new content is copied to the clipboard"
                                              AutomationProperties.Name="Enable Clipboard Content Viewer"/>
                                              
                                    <TextBlock Text="File Associations" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                                    
                                    <CheckBox Content="Associate .xsdp files with this application"
                                              IsChecked="{Binding IsPluginExtensionRegistered}"
                                              IsVisible="{Binding SupportsFileAssociations}"
                                              ToolTip.Tip="Allows double-clicking .xsdp plugin packages to install them"
                                              AutomationProperties.Name="Associate XSDP Files"/>
                                    
                                    <TextBlock Text="Note: Some integration features require platform-specific support and may not be available on all systems."
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Capture Command Palette -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Capture Command Palette" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Open a searchable overlay for configured capture and recording workflows."
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding CaptureCommandPaletteEnabled}"
                                              Content="Enable Capture Command Palette"
                                              AutomationProperties.Name="Enable Capture Command Palette"/>

                                    <Grid ColumnDefinitions="Auto, 16, *, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="Shortcut:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding CaptureCommandPaletteHotkeyText}"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="Capture Command Palette Shortcut"/>
                                        <Button Grid.Column="4"
                                                Content="Test Shortcut"
                                                Command="{Binding TestCaptureCommandPaletteShortcutCommand}"
                                                AutomationProperties.Name="Test Capture Command Palette Shortcut"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CaptureCommandPaletteStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Assistant -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Assistant" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Use a local-first command overlay for XerahS history and capture actions."
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding AssistantEnabled}"
                                              Content="Enable XerahS Assistant"
                                              AutomationProperties.Name="Enable Assistant"/>

                                    <Grid ColumnDefinitions="Auto, 16, *, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="Shortcut:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantHotkeyText}"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="Assistant Shortcut"/>
                                        <Button Grid.Column="4"
                                                Content="Test Shortcut"
                                                Command="{Binding TestAssistantShortcutCommand}"
                                                AutomationProperties.Name="Test Assistant Shortcut"/>
                                    </Grid>

                                    <TextBlock Text="{Binding AssistantHotkeyStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding AssistantPromptHistoryEnabled}"
                                              Content="Save assistant command history"
                                              AutomationProperties.Name="Save Assistant History"/>

                                    <TextBlock Text="AI Provider"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Margin="0,8,0,0"/>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="Provider:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding AssistantProviderOptions}"
                                                  SelectedItem="{Binding SelectedAssistantProvider}"
                                                  MinWidth="220"
                                                  AutomationProperties.Name="Assistant AI Provider">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AssistantProviderOptionViewModel">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantProviderModelId}"
                                                 PlaceholderText="Model ID"
                                                 AutomationProperties.Name="Assistant AI Model"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="Base URL:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantProviderBaseUrl}"
                                                 PlaceholderText="https://api.example.com/v1"
                                                 AutomationProperties.Name="Assistant AI Base URL"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="API key:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantProviderApiKey}"
                                                 PasswordChar="*"
                                                 PlaceholderText="Stored in the XerahS secret store"
                                                 IsEnabled="{Binding AssistantProviderNeedsApiKey}"
                                                 AutomationProperties.Name="Assistant AI API Key"/>
                                    </Grid>

                                    <TextBlock Text="{Binding AssistantProviderKeyStatus}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save Provider"
                                                Command="{Binding SaveAssistantProviderSettingsCommand}"
                                                AutomationProperties.Name="Save Assistant AI Provider"/>
                                        <Button Content="Validate"
                                                Command="{Binding ValidateAssistantProviderCommand}"
                                                AutomationProperties.Name="Validate Assistant AI Provider"/>
                                        <Button Content="Remove Key"
                                                Command="{Binding RemoveAssistantProviderKeyCommand}"
                                                IsEnabled="{Binding AssistantProviderHasApiKey}"
                                                AutomationProperties.Name="Remove Assistant AI Key"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding AssistantProviderStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- MCP Server -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="MCP Server" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Use the dedicated xerahs-mcp executable to expose XerahS over the Model Context Protocol."
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="Manifest URL:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding McpManifestUrl}"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="MCP Manifest URL"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="API key:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding McpApiKeyDisplay}"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="MCP API Key Preview"/>
                                    </Grid>

                                    <TextBlock Text="{Binding McpApiKeyStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Copy API Key"
                                                Command="{Binding CopyMcpApiKeyCommand}"
                                                AutomationProperties.Name="Copy MCP API Key"/>
                                        <Button Content="Generate or Regenerate API Key"
                                                Command="{Binding GenerateMcpApiKeyCommand}"
                                                AutomationProperties.Name="Generate MCP API Key"/>
                                        <Button Content="Copy Manifest URL"
                                                Command="{Binding CopyMcpManifestUrlCommand}"
                                                AutomationProperties.Name="Copy MCP Manifest URL"/>
                                    </StackPanel>

                                    <TextBlock Text="HTTP transport requires the bearer token above. If no key exists, the MCP runtime also generates one automatically on first launch."
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- XerahS Cloud Tab -->
            <TabItem Header="XerahS Cloud">
                <ScrollViewer controls:SettingsSearch.PageId="xerahs-cloud">
                    <StackPanel Spacing="24" Margin="24">
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="XerahS Cloud" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Publish screenshots and screencasts from History to your secure profile. Strong authentication and an active trial or subscription are required."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                                    <TextBlock Text="{Binding CloudStatusText}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="XerahS Cloud Status"/>

                                    <Grid ColumnDefinitions="Auto, 16, *" IsVisible="{Binding IsCloudSignedIn}">
                                        <TextBlock Grid.Column="0" Text="Profile URL:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding CloudProfileUrl}"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="XerahS Cloud Profile URL"/>
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="Sign in / Create account"
                                                Margin="0,0,8,8"
                                                Command="{Binding SignInToCloudCommand}"
                                                AutomationProperties.Name="Sign in to XerahS Cloud"/>
                                        <Button Content="Refresh status"
                                                Margin="0,0,8,8"
                                                Command="{Binding RefreshCloudStatusCommand}"
                                                AutomationProperties.Name="Refresh XerahS Cloud Status"/>
                                        <Button Content="Open profile"
                                                Margin="0,0,8,8"
                                                Command="{Binding OpenCloudProfileCommand}"
                                                AutomationProperties.Name="Open XerahS Cloud Profile"/>
                                        <Button Content="Copy profile URL"
                                                Margin="0,0,8,8"
                                                Command="{Binding CopyCloudProfileUrlCommand}"
                                                AutomationProperties.Name="Copy XerahS Cloud Profile URL"/>
                                        <Button Content="Security, billing &amp; account"
                                                Margin="0,0,8,8"
                                                Command="{Binding OpenCloudSettingsCommand}"
                                                AutomationProperties.Name="Open XerahS Cloud Web Settings"/>
                                        <Button Content="Sign out"
                                                Margin="0,0,8,8"
                                                Command="{Binding SignOutOfCloudCommand}"
                                                AutomationProperties.Name="Sign out of XerahS Cloud"/>
                                    </WrapPanel>

                                    <TextBlock Text="Web settings manage TOTP/passkeys (when enabled), recovery, active sessions, subscription, export, account deletion, and sign-out on all devices."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="History">
                <ScrollViewer controls:SettingsSearch.PageId="history">
                    <StackPanel Spacing="24" Margin="24">
                        <!-- History Settings -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="History" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding HistorySaveTasks}" Content="Save captured/uploaded items to history" AutomationProperties.Name="Save Tasks to History"/>
                                    <CheckBox IsChecked="{Binding HistoryCheckURL}" Content="Only save items with URL" AutomationProperties.Name="Only Save Tasks with URL"/>
                                    <CheckBox IsChecked="{Binding ScreenshotContentSearchEnabled}"
                                              Content="Make screenshots searchable"
                                              AutomationProperties.Name="Make Screenshots Searchable"/>
                                    <TextBlock Text="Reads text in new screenshots locally so History and Assistant search can find screenshots by visible words."
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recent Tasks Settings -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Recent Tasks" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding RecentTasksSave}" Content="Save recent tasks" AutomationProperties.Name="Save Recent Tasks"/>
                                    
                                    <Grid ColumnDefinitions="Auto, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="Maximum recent tasks:" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="2" 
                                                       Value="{Binding RecentTasksMaxCount}" 
                                                       Minimum="1" Maximum="100" 
                                                       MinWidth="120" HorizontalAlignment="Stretch"
                                                       AutomationProperties.Name="Max Recent Tasks"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Display Options" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                                    
                                    <CheckBox IsChecked="{Binding RecentTasksShowInMainWindow}" Content="Show recent tasks in main window" AutomationProperties.Name="Show Recent Tasks in Main Window"/>
                                    <CheckBox IsChecked="{Binding RecentTasksShowInTrayMenu}" Content="Show recent tasks in tray menu" AutomationProperties.Name="Show Recent Tasks in Tray Menu"/>
                                    <CheckBox IsChecked="{Binding RecentTasksTrayMenuMostRecentFirst}" 
                                              Content="Show most recent first in tray menu" 
                                              IsEnabled="{Binding RecentTasksShowInTrayMenu}"
                                              AutomationProperties.Name="Show Recent Tasks First"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

             <!-- Proxy Tab -->
            <TabItem Header="Proxy">
                <ScrollViewer controls:SettingsSearch.PageId="proxy">
                    <StackPanel Spacing="24" Margin="24">

                        <!-- Proxy Method -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Proxy Configuration" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="Proxy method:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding ProxyMethods}"
                                                  SelectedItem="{Binding ProxyMethod}"
                                                  HorizontalAlignment="Stretch" MinWidth="200"
                                                  AutomationProperties.Name="Proxy Method"/>
                                    </Grid>
                                    <TextBlock Text="Configure how network requests should be proxied. Changes apply immediately to all uploads."
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Manual Proxy Settings -->
                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsManualProxy}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Proxy Server" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding ProxyHost}"
                                                     PlaceholderText="proxy.example.com"
                                                     AutomationProperties.Name="Proxy Host"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="2"
                                                           Value="{Binding ProxyPort}"
                                                           Minimum="1" Maximum="65535"
                                                           MinWidth="120" HorizontalAlignment="Stretch"
                                                           AutomationProperties.Name="Proxy Port"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Authentication -->
                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsManualProxy}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Authentication (Optional)" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="Username:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding ProxyUsername}"
                                                     PlaceholderText="username"
                                                     AutomationProperties.Name="Proxy Username"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding ProxyPassword}"
                                                     PlaceholderText="password"
                                                     PasswordChar="•"
                                                     AutomationProperties.Name="Proxy Password"/>
                                        </Grid>
                                        <TextBlock Text="Leave username and password blank if your proxy does not require authentication."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

             <!-- Advanced Tab -->
             <TabItem Header="Advanced">
                <ScrollViewer controls:SettingsSearch.PageId="advanced">
                    <StackPanel Spacing="24" Margin="24">
                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding ShowUseModernCaptureSetting}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Capture Engine" FontWeight="SemiBold"/>
                                <Border BorderThickness="1" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <CheckBox IsChecked="{Binding UseModernCapture}" Content="Use Modern Screen Capture (Direct3D11 on Windows, XDG Portal on Linux). Requires restart." AutomationProperties.Name="Use Modern Capture"/>
                                        <CheckBox IsChecked="{Binding HDRScreenshotColorCorrection}" Content="Correct HDR display colors when capturing with GDI" AutomationProperties.Name="Correct HDR Display Colors"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsMacOSPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="macOS Region Selector" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Choose one selector for macOS interactive region capture so the native crosshair and XerahS overlay are not shown in the same workflow."
                                                   TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="120, 16, *">
                                            <TextBlock Grid.Column="0" Text="Region selector:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding MacOSRegionSelectorPreferences}"
                                                      SelectedItem="{Binding MacOSRegionSelectorPreference}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="240"
                                                      AutomationProperties.Name="macOS Region Selector">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="This is the default for macOS workflows and capture tools. Workflows set to Automatic follow this value."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox IsChecked="{Binding MacOSPlayCaptureSound}"
                                                  Content="Play native macOS capture sound"
                                                  AutomationProperties.Name="Play Native macOS Capture Sound"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Linux Region Selector" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Choose which selector XerahS should prefer for Linux interactive region selection."
                                                   TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="120, 16, *">
                                            <TextBlock Grid.Column="0" Text="Region selector:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding LinuxRegionSelectorPreferences}"
                                                      SelectedItem="{Binding LinuxRegionSelectorPreference}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="240"
                                                      AutomationProperties.Name="Linux Region Selector">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding LinuxRegionSelectorCurrentSessionText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorPortalBackendText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorAvailableText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorAutomaticText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorLastDecisionText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxOmaSnapStatusText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4" IsVisible="{Binding IsOmaSnapAvailable}">
                                            <Grid ColumnDefinitions="120, 16, *">
                                                <TextBlock Grid.Column="0" Text="Annotation editor:" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding LinuxAnnotationEditors}"
                                                          SelectedItem="{Binding LinuxAnnotationEditor}"
                                                          HorizontalAlignment="Stretch"
                                                          MinWidth="240"
                                                          AutomationProperties.Name="Linux Annotation Editor">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:Object">
                                                            <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="The OmaSnap editor is the native Hyprland overlay. Sidecar annotation files and re-editing from History stay with the XerahS editor."
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Linux Recording Backend" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Choose which recording backend XerahS should prefer for Linux screen recording workflows."
                                                   TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="120, 16, *">
                                            <TextBlock Grid.Column="0" Text="Recording backend:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding LinuxRecordingBackendPreferences}"
                                                      SelectedItem="{Binding LinuxRecordingBackendPreference}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="240"
                                                      AutomationProperties.Name="Linux Recording Backend">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="Automatic prefers native or portal-backed recording when available and falls back to FFmpeg when needed."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Linux Clipboard" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="12">
                                        <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12"
                                                IsVisible="{Binding ShowLinuxClipboardCliWarning}">
                                            <TextBlock Text="{Binding LinuxClipboardCliWarningText}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"/>
                                        </Border>
                                        <CheckBox IsChecked="{Binding PersistClipboardAfterExit}"
                                                  Content="Keep clipboard contents after XerahS exits (Wayland: uses wl-copy)"
                                                  AutomationProperties.Name="Persist Clipboard After Exit"/>
                                        <TextBlock Text="Background workflows (CLI, watch-folder daemon) need wl-clipboard or xclip. The .deb and .rpm packages recommend these tools."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True"
                                        DataContext="{Binding HotkeyDelivery}"
                                        x:DataType="vm:HotkeyDeliveryViewModel">
                                <TextBlock Text="Global Hotkeys" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding BackendName, StringFormat='Delivered by: {0}'}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding WarningText}"
                                                   IsVisible="{Binding ShowWarning}"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Spacing="8" IsVisible="{Binding ShowAccessSetup}">
                                            <TextBlock Text="{Binding AccessSetupDescription}" TextWrapping="Wrap"/>
                                            <Button Content="Grant keyboard access"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding GrantKeyboardAccessCommand}"
                                                    AutomationProperties.Name="Grant Keyboard Access For Global Hotkeys"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AccessSetupStatus}"
                                                   IsVisible="{Binding HasAccessSetupStatus}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsHyprlandKeybindingsSupported}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Hyprland Keybindings" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Let Hyprland own XerahS hotkeys (recommended on Omarchy). Hyprland runs &quot;omaxerahs workflow run&quot; for each workflow hotkey, so portal shortcuts no longer take keys such as PRINT or F1."
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Hyprland keybindings are on." IsVisible="{Binding IsHyprlandKeybindingsEnabled}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Review changes…" Command="{Binding ReviewHyprlandKeybindingsCommand}"
                                                    AutomationProperties.Name="Review Hyprland Keybinding Changes"/>
                                            <Button Content="Turn off" Command="{Binding DisableHyprlandKeybindingsCommand}"
                                                    IsVisible="{Binding IsHyprlandKeybindingsEnabled}"
                                                    AutomationProperties.Name="Turn Off Hyprland Keybindings"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding HyprlandKeybindingPlanText}"
                                                   FontFamily="monospace" FontSize="12" TextWrapping="Wrap"/>
                                        <StackPanel Spacing="8" IsVisible="{Binding HasHyprlandKeybindingPlan}">
                                            <CheckBox IsChecked="{Binding UnbindConflictingHyprlandKeys}"
                                                      IsVisible="{Binding HasHyprlandKeybindingConflicts}"
                                                      Content="Unbind the conflicting keys listed above so XerahS can use them"
                                                      AutomationProperties.Name="Unbind Conflicting Hyprland Keys"/>
                                            <Button Content="Apply to my Hyprland config" Command="{Binding ApplyHyprlandKeybindingsCommand}"
                                                    AutomationProperties.Name="Apply Hyprland Keybindings"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding HyprlandKeybindingStatusText}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="Wayland Portal Services" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <CheckBox IsChecked="{Binding LinuxUseWaylandPortalServices}"
                                                  Content="Use Wayland portal services for hotkeys, input capture, and open-uri integration. Requires restart."
                                                  AutomationProperties.Name="Use Wayland Portal Services"/>
                                        <TextBlock Text="This setting controls portal-backed desktop integration on Wayland. It does not choose the Linux screenshot region selector or recording backend."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Settings Backup and Restore" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Create one portable file containing application settings, workflows, destination instances, custom uploader definitions, and destination credentials. Restored credentials are encrypted by the destination computer."
                                               TextWrapping="Wrap"/>
                                    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                        <TextBlock Text="Security warning: the backup file is intentionally unencrypted and can contain plaintext passwords, S3 keys, and OAuth tokens. Protect it like a password vault."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Back Up to File..."
                                                Command="{Binding BackupSettingsToFileCommand}"
                                                AutomationProperties.Name="Back Up Settings to File"/>
                                        <Button Content="Restore from File..."
                                                Command="{Binding RestoreSettingsFromFileCommand}"
                                                AutomationProperties.Name="Restore Settings from File"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SettingsBackupStatusText}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="Application Configuration" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <controls:PropertyGrid x:Name="ApplicationConfigPropertyGrid"
                                                       SelectedObject="{Binding ApplicationConfig}"
                                                       AutomationProperties.Name="Application Config Properties"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</views:PageView>
