<ui:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:XerahS.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:local="using:XerahS.UI.Markup"
        xmlns:media="using:XerahS.Media"
        mc:Ignorable="d"
        d:DesignWidth="760" d:DesignHeight="500"
        x:Class="XerahS.UI.Views.ImageCombinerWindow"
        x:DataType="vm:ImageCombinerViewModel"
        Title="{local:Localize ImageCombiner_Title}"
        Width="760" Height="500"
        MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        DragDrop.AllowDrop="True">

  <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          Padding="16">
    <Grid RowDefinitions="*,Auto,Auto,Auto"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

    <!-- Row 0: Image list -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <ListBox Grid.Column="0"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem}"
               AutomationProperties.Name="Image list">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ImageCombinerInputItem">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Dimensions}" Foreground="Gray" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{local:Localize ImageCombiner_Remove}"
                      Command="{Binding $parent[ListBox].DataContext.RemoveItemCommand}"
                      CommandParameter="{Binding}"
                      Classes="accent"
                      MinWidth="30" MinHeight="26"
                      Padding="6,2"
                      AutomationProperties.Name="Remove" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Top">
        <Button Content="{local:Localize ImageCombiner_Add}"
                Command="{Binding AddFilesCommand}"
                Classes="accent"
                MinWidth="80"
                AutomationProperties.Name="Add files" />
        <Button Content="{local:Localize ImageCombiner_MoveUp}"
                Command="{Binding MoveUpCommand}"
                CommandParameter="{Binding SelectedItem}"
                Classes="accent"
                MinWidth="80"
                AutomationProperties.Name="Move up" />
        <Button Content="{local:Localize ImageCombiner_MoveDown}"
                Command="{Binding MoveDownCommand}"
                CommandParameter="{Binding SelectedItem}"
                Classes="accent"
                MinWidth="80"
                AutomationProperties.Name="Move down" />
        <Button Content="{local:Localize ImageCombiner_Clear}"
                Command="{Binding ClearCommand}"
                Classes="accent"
                MinWidth="80"
                AutomationProperties.Name="Clear all" />
      </StackPanel>
    </Grid>

    <!-- Row 1: Options -->
    <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="16" LineSpacing="8" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{local:Localize ImageCombiner_OrientationLabel}" VerticalAlignment="Center" />
        <ComboBox SelectedIndex="0"
                  SelectedItem="{Binding Orientation}"
                  MinWidth="120"
                  AutomationProperties.Name="Orientation">
          <media:ImageCombinerOrientation>Vertical</media:ImageCombinerOrientation>
          <media:ImageCombinerOrientation>Horizontal</media:ImageCombinerOrientation>
        </ComboBox>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{local:Localize ImageCombiner_AlignmentLabel}" VerticalAlignment="Center" />
        <ComboBox SelectedIndex="1"
                  SelectedItem="{Binding Alignment}"
                  MinWidth="100"
                  AutomationProperties.Name="Alignment">
          <media:ImageCombinerAlignment>Near</media:ImageCombinerAlignment>
          <media:ImageCombinerAlignment>Center</media:ImageCombinerAlignment>
          <media:ImageCombinerAlignment>Far</media:ImageCombinerAlignment>
        </ComboBox>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{local:Localize ImageCombiner_SpacingLabel}" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Spacing}"
                       Minimum="0" Maximum="100" Increment="1"
                       MinWidth="80"
                       AutomationProperties.Name="Spacing" />
      </StackPanel>

      <CheckBox Content="{local:Localize ImageCombiner_FillBackground}"
                IsChecked="{Binding AutoFillBackground}"
                VerticalAlignment="Center"
                AutomationProperties.Name="Auto fill background" />
    </WrapPanel>

    <!-- Row 2: Status -->
    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,0,0,12" />

    <!-- Row 3: Buttons -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{local:Localize ImageCombiner_Combine}"
              Command="{Binding CombineCommand}"
              MinWidth="100"
              Classes="accent"
              IsEnabled="{Binding !IsProcessing}"
              AutomationProperties.Name="Combine images" />
      <Button Content="{local:Localize ImageCombiner_Close}"
              Click="OnCloseClick"
              Classes="accent"
              MinWidth="80"
              AutomationProperties.Name="Close" />
    </StackPanel>

    </Grid>
  </Border>
</ui:SurfaceWindow>
