<ui:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:XerahS.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:local="using:XerahS.UI.Markup"
        mc:Ignorable="d"
        d:DesignWidth="500" d:DesignHeight="350"
        x:Class="XerahS.UI.Views.ImageSplitterWindow"
        x:DataType="vm:ImageSplitterViewModel"
        Title="{local:Localize ImageSplitter_Title}"
        Width="500" Height="350"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

    <!-- Row 0: Input file -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0"
               Text="{Binding InputFilePath}"
               PlaceholderText="{local:Localize ImageSplitter_PlaceholderSelectImage}"
               IsReadOnly="True"
               AutomationProperties.Name="Input file path" />
      <Button Grid.Column="1"
              Content="{local:Localize ImageSplitter_Browse}"
              Command="{Binding BrowseInputCommand}"
              Classes="accent"
              Margin="8,0,0,0"
              MinWidth="90"
              AutomationProperties.Name="Browse input file" />
    </Grid>

    <!-- Row 1: Dimensions info -->
    <TextBlock Grid.Row="1"
               Text="{Binding StatusText}"
               Margin="0,0,0,12"
               IsVisible="{Binding HasInput}" />

    <!-- Row 2: Rows / Columns -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{local:Localize ImageSplitter_ColumnsLabel}" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Columns}"
                       Minimum="1" Maximum="20" Increment="1"
                       MinWidth="80"
                       AutomationProperties.Name="Columns" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{local:Localize ImageSplitter_RowsLabel}" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Rows}"
                       Minimum="1" Maximum="20" Increment="1"
                       MinWidth="80"
                       AutomationProperties.Name="Rows" />
      </StackPanel>
    </StackPanel>

    <!-- Row 3: Output folder -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="{local:Localize ImageSplitter_OutputLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1"
               Text="{Binding OutputFolder}"
               IsReadOnly="True"
               AutomationProperties.Name="Output folder" />
      <Button Grid.Column="2"
              Content="{local:Localize ImageSplitter_Browse}"
              Command="{Binding BrowseOutputCommand}"
              Classes="accent"
              Margin="8,0,0,0"
              MinWidth="90"
              AutomationProperties.Name="Browse output folder" />
    </Grid>

    <!-- Row 4: Spacer -->

    <!-- Row 5: Buttons -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{local:Localize ImageSplitter_Split}"
              Command="{Binding SplitCommand}"
              MinWidth="100"
              Classes="accent"
              IsEnabled="{Binding HasInput}"
              AutomationProperties.Name="Split image" />
      <Button Content="{local:Localize ImageSplitter_Close}"
              Click="OnCloseClick"
              Classes="accent"
              MinWidth="80"
              AutomationProperties.Name="Close" />
    </StackPanel>

    </Grid>
  </Border>
</ui:SurfaceWindow>
