<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:converters="using:XerahS.UI.Converters"
             xmlns:local="using:XerahS.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="XerahS.UI.Views.TaskVideoSettingsPanel"
             x:DataType="vm:TaskSettingsViewModel">

    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="24" Margin="20">
            <!-- Screen Recorder Settings -->
            <StackPanel Spacing="8">
                <TextBlock Text="{local:Localize TaskSettings_ScreenRecorder}" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="16">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize TaskSettings_Fps}" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding ScreenRecordFPS}" Minimum="1" Maximum="144" Increment="1" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="FPS"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Localize TaskSettings_Duration}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding ScreenRecordDuration}" Minimum="0" Maximum="3600" Increment="1" Width="120" AutomationProperties.Name="Recording Duration"/>
                                <TextBlock Text="{local:Localize TaskSettings_SecondsDisable}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Localize TaskSettings_StartDelay}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding ScreenRecordStartDelay}" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.0" Width="120" AutomationProperties.Name="Recording Start Delay"/>
                                <TextBlock Text="{local:Localize AutoCapture_Seconds}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Localize TaskSettings_RecordingIntent}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding RecordingIntents}" SelectedItem="{Binding RecordingIntent}" HorizontalAlignment="Stretch" MinWidth="200" AutomationProperties.Name="Recording Intent"/>
                            
                            <!-- Video Codec Selector -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:Localize TaskSettings_VideoCodec}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding ScreenRecordVideoCodec}" HorizontalAlignment="Stretch" MinWidth="200" AutomationProperties.Name="Video Codec"/>
                        </Grid>

                        <StackPanel Spacing="10" IsVisible="{Binding IsLinuxPlatform}">
                            <TextBlock Text="{local:Localize TaskSettings_PreferredLinuxRecordingBackend}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding LinuxRecordingBackendPreferences}"
                                      SelectedItem="{Binding LinuxRecordingBackendPreference}"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="240"
                                      AutomationProperties.Name="Preferred Linux Recording Backend">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Object">
                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{local:Localize Settings_Advanced_LinuxRecordingBackendNote}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FFmpeg Tools -->
            <StackPanel Spacing="8">
                <TextBlock Text="{local:Localize TaskSettings_FfmpegTools}" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{local:Localize TaskSettings_FfmpegToolsDescription}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        
                        <TextBlock Text="{Binding FFmpegStatusText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding FFmpegStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                        
                        <Grid ColumnDefinitions="Auto, 16, Auto">
                            <Button Grid.Column="0" Content="{local:Localize TaskSettings_DownloadFfmpeg}"
                                    Command="{Binding DownloadFFmpegCommand}"
                                    IsVisible="{Binding ShowDownloadFFmpeg}"
                                    IsEnabled="{Binding CanDownloadFFmpeg}"/>

                            <Button Grid.Column="2" Content="{local:Localize TaskSettings_ConfigureFfmpeg}"
                                    Command="{Binding OpenFFmpegOptionsCommand}"/>
                        </Grid>
                        
                        <TextBox Text="{Binding ExpectedFFmpegDownloadUrl}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinWidth="360"
                                 IsVisible="{Binding ShowExpectedFFmpegDownloadUrl}"
                                 AutomationProperties.Name="Expected FFmpeg Download URL"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Linux Recording Diagnostics -->
            <StackPanel Spacing="8" IsVisible="{Binding IsLinuxPlatform}">
                <TextBlock Text="{local:Localize TaskSettings_LinuxRecordingDiagnostics}" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{local:Localize TaskSettings_LinuxDiagnosticsDescription}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Button Content="{local:Localize TaskSettings_RunLinuxDiagnostics}"
                                Command="{Binding RunLinuxRecordingDiagnosticsCommand}"
                                HorizontalAlignment="Left"/>

                        <TextBlock Text="{Binding LinuxRecordingDiagnosticsStatusText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding LinuxRecordingDiagnosticsStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
