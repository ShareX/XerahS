<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:views="using:XerahS.UI.Views"
        xmlns:converters="using:XerahS.UI.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="XerahS.UI.Views.WorkflowEditorView"
        x:DataType="vm:WorkflowEditorViewModel">

    <UserControl.Styles>
        <Style Selector="Border#EditorSurface.inline">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabControl#WorkflowSections.inline">
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="TabControl#WorkflowSections.inline > TabItem">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="TabControl#WorkflowSections.inline StackPanel#TaskIdentityBody">
            <Setter Property="MinWidth" Value="320"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="EditorSurface" Classes.inline="{Binding IsInline}" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="16">
        <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <!-- Main Tabs -->
            <TabControl x:Name="WorkflowSections" Classes.inline="{Binding IsInline}" Grid.Row="0" Margin="0,0,0,16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Workflow Settings Sections">
            
            <!-- Tab 1: Task (Trigger & Job) -->
            <TabItem Header="Task">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TaskIdentityBody" Margin="24" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Workflow ID" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Text="{Binding WorkflowId}"
                                     IsReadOnly="True"
                                     AutomationProperties.Name="Workflow ID (ReadOnly)"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Description" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Text="{Binding Description}" 
                                     PlaceholderText="Optional description"
                                     AutomationProperties.Name="Workflow Description"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Task" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Grid ColumnDefinitions="*, 12, *">
                                <ComboBox Grid.Column="0" 
                                          ItemsSource="{Binding JobCategories}" 
                                          SelectedItem="{Binding SelectedJobCategory}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Select Category"
                                          AutomationProperties.Name="Job Category Selection">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:JobCategoryViewModel">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <ComboBox Grid.Column="2" 
                                          ItemsSource="{Binding SelectedJobCategory.Jobs}" 
                                          SelectedItem="{Binding SelectedJobItem}"
                                          IsEnabled="{Binding SelectedJobCategory, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Select Task"
                                          AutomationProperties.Name="Job Task Selection">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyItemViewModel">
                                            <TextBlock Text="{Binding Description}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{Binding SelectedJobDescription}"
                                       Theme="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Hotkey" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" 
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        MinWidth="150">
                                    <Button x:Name="HotkeyButton"
                                            Content="{Binding KeyText}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            Focusable="True"
                                            Cursor="Hand"
                                            Click="HotkeyButton_Click"
                                            AutomationProperties.Name="Hotkey Recorder Button"/>
                                </Border>
                                <Button Grid.Column="1" 
                                        Content="Clear" 
                                        Command="{Binding ClearCommand}" 
                                        AutomationProperties.Name="Clear Hotkey"/>
                            </Grid>
                            <TextBlock Text="Click to record. Press Escape to cancel." 
                                       Theme="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Tab 2: Image Settings (visible for screen capture jobs) -->
            <TabItem Header="{Binding ImageSectionTitle}" IsVisible="{Binding TaskSettings.IsScreenCaptureJob}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <views:TaskImageSettingsPanel DataContext="{Binding TaskSettings}" MinWidth="700"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Video Settings (visible for screen record jobs) -->
            <TabItem Header="{Binding VideoSectionTitle}" IsVisible="{Binding TaskSettings.IsScreenRecordJob}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <views:TaskVideoSettingsPanel DataContext="{Binding TaskSettings}" MinWidth="600"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Task Settings (Renamed from Settings / Other Settings) -->
            <TabItem Header="{Binding TaskSettingsSectionTitle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <views:TaskSettingsPanel DataContext="{Binding TaskSettings}" MinWidth="600"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: Index Folder -->
            <TabItem Header="{Binding IndexSectionTitle}" IsVisible="{Binding TaskSettings.IsIndexFolderJob}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <views:IndexFolderPanel DataContext="{Binding IndexFolderConfig}" MinWidth="600"/>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" IsVisible="{Binding !IsInline}" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="OK" Click="OkButton_Click" IsDefault="True" Width="80" AutomationProperties.Name="OK"/>
            <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True" Width="80" AutomationProperties.Name="Cancel"/>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
