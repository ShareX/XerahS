<views:SurfaceWindow xmlns:views="using:XerahS.UI.Views" xmlns:models="using:XerahS.History" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:XerahS.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:history="using:XerahS.UI.Controls"
        xmlns:theming="using:ShareX.ImageEditor.Presentation.Theming"
        mc:Ignorable="d"
        d:DesignWidth="1060"
        d:DesignHeight="900"
        x:Class="XerahS.UI.Views.StatisticsView"
        Title="{x:Static localization:StatisticsStrings.StatsWindow_Title}"
        Width="1060"
        Height="900"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <views:SurfaceWindow.Resources>
        <SolidColorBrush x:Key="Statistics.PositiveBrush" Color="{DynamicResource XerahS.Color.Status.Success.Foreground}"/>
        <SolidColorBrush x:Key="Statistics.NegativeBrush" Color="{DynamicResource XerahS.Color.Status.Error.Foreground}"/>
    </views:SurfaceWindow.Resources>

    <views:SurfaceWindow.Styles>
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="avares://ShareX.ImageEditor/Assets#lucide"/>
        </Style>
        <Style Selector="Button.filter-button.active">
            <Setter Property="Background" Value="{DynamicResource XerahS.Brush.Accent.Solid}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="Grid.page-title">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style Selector="TextBlock.page-title-text">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource XerahS.Brush.Accent.Solid}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.page-title-icon">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource XerahS.Brush.Accent.Solid}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Grid.section-header">
            <Setter Property="ColumnSpacing" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Grid.section-header TextBlock.section-title">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.legend-text">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.change-up">
            <Setter Property="Foreground" Value="{DynamicResource Statistics.PositiveBrush}"/>
        </Style>
        <Style Selector="TextBlock.change-down">
            <Setter Property="Foreground" Value="{DynamicResource Statistics.NegativeBrush}"/>
        </Style>
        <Style Selector="Button.filter-button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style Selector="ComboBox.form-control">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.row-label.peak">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.row-value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.stats-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Border.stats-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
    </views:SurfaceWindow.Styles>

    <views:SurfaceWindow.DataTemplates>
        <DataTemplate DataType="views:StatsRow" x:DataType="views:StatsRow">
            <Border Classes="stats-row" ToolTip.Tip="{Binding ToolTip}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="row-label"
                               Classes.peak="{Binding IsPeak}"
                               Width="{Binding LabelWidth}"
                               Text="{Binding Label}"/>
                    <history:StatsMeter Grid.Column="1"
                                        Fraction="{Binding Fraction}"
                                        IsPeak="{Binding IsPeak}"
                                        VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Classes="row-value"
                               MinWidth="44"
                               Text="{Binding Value}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </views:SurfaceWindow.DataTemplates>

    <Grid Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border x:Name="SnapshotPanel" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="24">
                <StackPanel>
                    <Grid Classes="page-title" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                        <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.chart_column}"/>
                        <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static localization:StatisticsStrings.StatsWindow_Stats}"/>
                        <TextBlock x:Name="SubtitleText" Grid.Column="2" Classes="hint" Margin="6,4,0,0"/>
                        <StackPanel x:Name="ActionsPanel" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="RefreshButton" AutomationProperties.Name="Refresh statistics" Click="OnRefreshClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.refresh_cw}"/>
                                    <TextBlock Text="{x:Static localization:StatisticsStrings.StatsWindow_Refresh}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShareButton" AutomationProperties.Name="Share statistics image"
                                    Click="OnShareClick"
                                    IsEnabled="False"
                                    ToolTip.Tip="{x:Static localization:StatisticsStrings.StatsWindow_ShareToolTip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.share_2}"/>
                                    <TextBlock Text="{x:Static localization:StatisticsStrings.StatsWindow_Share}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="StatusPanel" Classes="section-card" Padding="24">
                        <TextBlock x:Name="StatusText"
                                   Classes="hint"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="{x:Static localization:StatisticsStrings.HistoryWindow_CalculatingStatistics}"/>
                    </Border>

                    <StackPanel x:Name="ContentPanel" IsVisible="False" Spacing="8">
                        <!-- Total -->
                        <Border Classes="section-card">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32">
                                <StackPanel>
                                    <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_Total}"/>
                                    <TextBlock x:Name="TotalText" Classes="stat-value" FontSize="32"/>
                                    <TextBlock x:Name="RateText" Classes="hint"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                    <history:StatsSplitBar x:Name="SplitBar"/>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="22" LineSpacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <history:StatsSwatch Kind="Image"/>
                                            <TextBlock Classes="legend-text" Text="{x:Static localization:StatisticsStrings.StatsWindow_Images}"/>
                                            <TextBlock x:Name="ImagesCountText" Classes="legend-text" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ImagesShareText" Classes="hint"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <history:StatsSwatch Kind="Recording"/>
                                            <TextBlock Classes="legend-text" Text="{x:Static localization:StatisticsStrings.StatsWindow_Recordings}"/>
                                            <TextBlock x:Name="RecordingsCountText" Classes="legend-text" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="RecordingsShareText" Classes="hint"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <history:StatsSwatch Kind="Other"/>
                                            <TextBlock Classes="legend-text" Text="{x:Static localization:StatisticsStrings.StatsWindow_OtherFiles}"/>
                                            <TextBlock x:Name="OtherCountText" Classes="legend-text" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="OtherShareText" Classes="hint"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Highlights -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Classes="section-card">
                                <StackPanel>
                                    <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_Today}"/>
                                    <TextBlock x:Name="TodayText" Classes="stat-value"/>
                                    <TextBlock x:Name="TodayNoteText" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="section-card">
                                <StackPanel>
                                    <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_Past7Days}"/>
                                    <TextBlock x:Name="WeekText" Classes="stat-value"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                        <TextBlock x:Name="WeekChangeText" Classes="hint" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WeekNoteText" Grid.Column="1" Classes="hint"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="section-card">
                                <StackPanel>
                                    <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_Streak}"/>
                                    <TextBlock x:Name="StreakText" Classes="stat-value"/>
                                    <TextBlock x:Name="StreakNoteText" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="section-card">
                                <StackPanel>
                                    <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_BusiestDay}"/>
                                    <TextBlock x:Name="BusiestDayText" Classes="stat-value"/>
                                    <TextBlock x:Name="BusiestDayNoteText" Classes="hint"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Every day -->
                        <Border Classes="section-card">
                            <StackPanel>
                                <Grid Classes="section-header" ColumnDefinitions="*,Auto,Auto">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Top">
                                        <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_EveryDay}"/>
                                        <TextBlock x:Name="CalendarNoteText" Grid.Column="1" Classes="hint"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Classes="hint" FontSize="11" Text="{x:Static localization:StatisticsStrings.StatsWindow_Less}"/>
                                        <history:StatsSwatch IsRamp="True"/>
                                        <TextBlock Classes="hint" FontSize="11" Text="{x:Static localization:StatisticsStrings.StatsWindow_More}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="SpanComboBox" AutomationProperties.Name="Calendar range"
                                              Grid.Column="2"
                                              Classes="form-control"
                                              VerticalAlignment="Center"
                                              SelectionChanged="OnSpanSelectionChanged"/>
                                </Grid>
                                <history:StatsCalendar x:Name="Calendar" AutomationProperties.Name="Daily activity heatmap"/>
                            </StackPanel>
                        </Border>

                        <!-- Time of day -->
                        <Border Classes="section-card">
                            <StackPanel>
                                <Grid Classes="section-header" ColumnDefinitions="*,Auto">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Top">
                                        <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_TimeOfDay}"/>
                                        <TextBlock x:Name="HoursNoteText" Grid.Column="1" Classes="hint"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="FilterAllButton"
                                                Classes="filter-button active"
                                                Tag="{x:Static models:HistoryStatsFilter.All}"
                                                Click="OnHourFilterClick"
                                                Content="{x:Static localization:StatisticsStrings.StatsWindow_All}"/>
                                        <Button x:Name="FilterImagesButton"
                                                Classes="filter-button"
                                                Tag="{x:Static models:HistoryStatsFilter.Images}"
                                                Click="OnHourFilterClick"
                                                Content="{x:Static localization:StatisticsStrings.StatsWindow_Images}"/>
                                        <Button x:Name="FilterRecordingsButton"
                                                Classes="filter-button"
                                                Tag="{x:Static models:HistoryStatsFilter.Recordings}"
                                                Click="OnHourFilterClick"
                                                Content="{x:Static localization:StatisticsStrings.StatsWindow_Recordings}"/>
                                    </StackPanel>
                                </Grid>
                                <history:StatsHourChart x:Name="HourChart" AutomationProperties.Name="Hourly activity chart" Height="230"/>
                            </StackPanel>
                        </Border>

                        <!-- Breakdowns -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Classes="section-card">
                                <StackPanel>
                                    <Grid Classes="section-header" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_DayOfWeek}"/>
                                        <TextBlock x:Name="WeekdaysNoteText" Grid.Column="1" Classes="hint"/>
                                    </Grid>
                                    <ItemsControl x:Name="WeekdaysList"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="section-card">
                                <StackPanel>
                                    <Grid Classes="section-header" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_TopApps}"/>
                                    </Grid>
                                    <ItemsControl x:Name="AppsList"/>
                                    <TextBlock x:Name="AppsEmptyText" Classes="hint" Text="{x:Static localization:StatisticsStrings.StatsWindow_NoData}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Classes="section-card">
                                <StackPanel>
                                    <Grid Classes="section-header" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_Destinations}"/>
                                    </Grid>
                                    <ItemsControl x:Name="DestinationsList"/>
                                    <TextBlock x:Name="DestinationsEmptyText" Classes="hint" Text="{x:Static localization:StatisticsStrings.StatsWindow_NoData}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="section-card">
                                <StackPanel>
                                    <Grid Classes="section-header" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="section-title" Text="{x:Static localization:StatisticsStrings.StatsWindow_FileTypes}"/>
                                    </Grid>
                                    <ItemsControl x:Name="FileTypesList"/>
                                    <TextBlock x:Name="FileTypesEmptyText" Classes="hint" Text="{x:Static localization:StatisticsStrings.StatsWindow_NoData}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</views:SurfaceWindow>
