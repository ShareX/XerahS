<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:vm="using:XerahS.UI.ViewModels"
                xmlns:uiconverters="clr-namespace:XerahS.UI.Converters"
                xmlns:history="using:XerahS.History"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                x:Class="XerahS.UI.Views.HistoryView"
                x:DataType="vm:HistoryViewModel"
                x:Name="Root"
                Cursor="Arrow">
    
    <Design.DataContext>
        <vm:HistoryViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search history"
                             MinWidth="260"
                             AutomationProperties.Name="Search History"/>
                    <Button Content="Search"
                            Command="{Binding SearchHistoryCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            AutomationProperties.Name="Search History"/>
                    <Button Content="Clear"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearchActive}"
                            IsEnabled="{Binding !IsLoading}"
                            AutomationProperties.Name="Clear History Search"/>

                    <Separator Classes="vertical" Height="20"/>

                    <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" 
                            IsEnabled="{Binding !IsLoading}"
                            AutomationProperties.Name="Refresh History"/>
                    <Button Content="Statistics" Click="OnStatisticsClick" AutomationProperties.Name="Show history statistics"/>
                    <!-- List View button: shown when grid view is active -->
                    <Button Command="{Binding ToggleViewCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            IsVisible="{Binding IsGridView}"
                            AutomationProperties.Name="Switch to List View">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE1D1;"
                                       FontFamily="avares://ShareX.ImageEditor/Assets#lucide"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="List View" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Grid View button: shown when list view is active -->
                    <Button Command="{Binding ToggleViewCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            IsVisible="{Binding !IsGridView}"
                            AutomationProperties.Name="Switch to Grid View">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE4FF;"
                                       FontFamily="avares://ShareX.ImageEditor/Assets#lucide"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Grid View" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Separator Classes="vertical" Height="20"/>

                    <TextBlock Text="{Binding HistoryItems.Count, StringFormat='{}{0} items'}" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            IsVisible="{Binding ShowCombineActions}">
                    <TextBlock Text="{Binding CombineSelectionSummary}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button Content="Combine Horizontal"
                            Command="{Binding CombineHorizontalCommand}"
                            IsEnabled="{Binding !IsCombiningSelection}"
                            AutomationProperties.Name="Combine images horizontally"/>
                    <Button Content="Combine Vertical"
                            Command="{Binding CombineVerticalCommand}"
                            IsEnabled="{Binding !IsCombiningSelection}"
                            AutomationProperties.Name="Combine images vertically"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Loading State -->
        <Border Grid.Row="2" IsVisible="{Binding IsLoading}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading history..." HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- List View Header -->
        <Border Grid.Row="1" Padding="16,8" Background="{DynamicResource LayerFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding !IsGridView}" IsEnabled="{Binding !IsLoading}">
            <Grid ColumnDefinitions="48, *, 160, 220">
                <TextBlock Grid.Column="1" Text="Filename" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="Type / Host" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="Date" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Grid View -->
        <ListBox x:Name="GridHistoryListBox"
                 Grid.Row="2"
                 ItemsSource="{Binding HistoryItems}"
                 IsVisible="{Binding IsGridView}"
                 IsEnabled="{Binding !IsLoading}"
                 Margin="16"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Multiple"
                 SelectionChanged="OnHistorySelectionChanged"
                 AutomationProperties.Name="History Grid">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryItem">
                    <Border Classes="history-grid-item"
                            Margin="8" Width="200"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4" 
                            Padding="12"
                            Cursor="Hand"
                            DoubleTapped="OnItemDoubleTapped"
                            ContextFlyout="{StaticResource HistoryItemMenuFlyout}"
                            AutomationProperties.Name="{Binding FileName, StringFormat='History Item: {0}'}">
                        <Border.Tag>
                            <MultiBinding Converter="{x:Static uiconverters:HistoryItemMenuContextConverter.Instance}">
                                <Binding/>
                                <Binding ElementName="Root" Path="DataContext"/>
                            </MultiBinding>
                        </Border.Tag>
                        <StackPanel Spacing="12">
                            <!-- Thumbnail -->
                            <Border Height="140" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding FilePath, Converter={x:Static vm:HistoryViewModel.ThumbnailConverter}}"
                                           Stretch="Uniform"/>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="#B8181818"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsVideo}"
                                            AutomationProperties.Name="Video recording">
                                        <TextBlock Text="▶"
                                                   FontSize="16"
                                                   Foreground="#A9A9A9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0,0,1"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="6"
                                            Padding="6,3"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            IsVisible="{Binding HasEditableAnnotations}"
                                            AutomationProperties.Name="Editable annotations available">
                                        <TextBlock Text="Edit"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Info -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DateTime, StringFormat='yyyy-MM-dd HH:mm'}" 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected Border.history-grid-item">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Style>
            </ListBox.Styles>
        </ListBox>
        
        <!-- List View -->
        <ListBox x:Name="ListHistoryListBox"
                 Grid.Row="2"
                 ItemsSource="{Binding HistoryItems}"
                 IsVisible="{Binding !IsGridView}"
                 IsEnabled="{Binding !IsLoading}"
                 Padding="0,8"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Multiple"
                 SelectionChanged="OnHistorySelectionChanged"
                 AutomationProperties.Name="History List">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryItem">
                    <Border Classes="history-list-item"
                            Padding="16,8" Background="Transparent" Cursor="Hand"
                            DoubleTapped="OnItemDoubleTapped"
                            ContextFlyout="{StaticResource HistoryItemMenuFlyout}"
                            AutomationProperties.Name="{Binding FileName, StringFormat='History Item: {0}'}">
                        <Border.Tag>
                            <MultiBinding Converter="{x:Static uiconverters:HistoryItemMenuContextConverter.Instance}">
                                <Binding/>
                                <Binding ElementName="Root" Path="DataContext"/>
                            </MultiBinding>
                        </Border.Tag>
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="48, *, 160, 220">
                            <!-- Thumbnail -->
                            <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding FilePath, Converter={x:Static vm:HistoryViewModel.ThumbnailConverter}}"
                                           Stretch="UniformToFill"/>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="18"
                                            Height="18"
                                            CornerRadius="9"
                                            Background="#B8181818"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsVideo}"
                                            AutomationProperties.Name="Video recording">
                                        <TextBlock Text="▶"
                                                   FontSize="8"
                                                   Foreground="#A9A9A9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="1,0,0,0"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="10"
                                            Height="10"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            IsVisible="{Binding HasEditableAnnotations}"
                                            AutomationProperties.Name="Editable annotations available"/>
                                </Grid>
                            </Border>
                            <!-- Filename -->
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" 
                                       VerticalAlignment="Center" Margin="16,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- Type/Host -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           IsVisible="{Binding Host, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <!-- DateTime -->
                            <TextBlock Grid.Column="3" Text="{Binding DateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                       VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected Border.history-list-item">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                </Style>
            </ListBox.Styles>
        </ListBox>

        <!-- Pagination Footer -->
        <Border Grid.Row="3" Padding="16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding CanGoPrevious}"
                        AutomationProperties.Name="Previous Page"/>
                
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                
                <Button Content="Next" Command="{Binding NextPageCommand}" 
                        IsEnabled="{Binding CanGoNext}"
                        AutomationProperties.Name="Next Page"/>
            </StackPanel>
        </Border>
    </Grid>
</views:PageView>
