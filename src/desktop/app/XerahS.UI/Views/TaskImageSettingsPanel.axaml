<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:controls="using:XerahS.UI.Controls"
             xmlns:converters="using:XerahS.UI.Converters"
             xmlns:local="using:XerahS.UI.Markup"
             xmlns:imagefx="clr-namespace:ShareX.ImageEditor.Core.ImageEffects;assembly=ShareX.ImageEditor"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="XerahS.UI.Views.TaskImageSettingsPanel"
             x:DataType="vm:TaskSettingsViewModel">

    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A thicker thumb makes the scrollable comparison list obvious at a glance. -->
        <Style Selector="ScrollViewer.hdr-scroll /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Width" Value="14"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="16">
        <TabControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <!-- Image Settings Tab -->
            <TabItem Header="{local:Localize TaskImage_TabSettings}">
                <ScrollViewer>
                    <Grid ColumnDefinitions="*, 24, *" RowDefinitions="Auto, 16, Auto" Margin="8">
                        <!-- Quality -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="{local:Localize TaskImage_Quality}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskImage_Format}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding ImageFormat}" HorizontalAlignment="Stretch" AutomationProperties.Name="Image Format"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskImage_JpegQuality}" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="2" Value="{Binding ImageJPEGQuality}" Minimum="0" Maximum="100" Increment="1" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="JPEG Quality"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskImage_PngBitDepth}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding PngBitDepthOptions}" SelectedItem="{Binding ImagePNGBitDepth}" HorizontalAlignment="Stretch" AutomationProperties.Name="PNG Bit Depth">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{local:Localize TaskSettings_PngDepthHelp}"
                                               Opacity="0.75" FontSize="11" TextWrapping="Wrap"
                                               AutomationProperties.Name="PNG bit depth explanation"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Thumbnail -->
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="{local:Localize TaskImage_Thumbnail}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskImage_Width}" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="2" Value="{Binding ThumbnailWidth}" Minimum="0" Maximum="10000" Increment="10" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="Thumbnail Width"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskImage_Height}" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="2" Value="{Binding ThumbnailHeight}" Minimum="0" Maximum="10000" Increment="10" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="Thumbnail Height"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskImage_Name}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding ThumbnailName}" AutomationProperties.Name="Thumbnail Name suffix"/>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding ThumbnailCheckSize}" Content="{local:Localize TaskImage_ThumbnailOnlyIfSmaller}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- HDR -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="8">
                            <TextBlock Text="{local:Localize TaskSettings_HdrSection}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="240, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_HdrGeneral}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding HdrToneMappingOptions}" SelectedItem="{Binding ImageHdrToneMapping}" HorizontalAlignment="Stretch" MinWidth="200" AutomationProperties.Name="HDR General Tone Mapping">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="240, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_HdrSave}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding HdrToneMappingOptions}" SelectedItem="{Binding ImageHdrSaveToneMapping}" IsEnabled="{Binding IsHdrSaveToneMappingEnabled}" HorizontalAlignment="Stretch" MinWidth="200" AutomationProperties.Name="HDR Save Tone Mapping">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{local:Localize TaskSettings_HdrSaveDisabledHint}"
                                               Opacity="0.75" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding !IsHdrSaveToneMappingEnabled}"
                                               AutomationProperties.Name="HDR save tone mapping disabled hint"/>
                                    <Grid ColumnDefinitions="240, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_HdrClipboard}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding HdrToneMappingOptions}" SelectedItem="{Binding ImageHdrClipboardToneMapping}" HorizontalAlignment="Stretch" MinWidth="200" AutomationProperties.Name="HDR Clipboard Tone Mapping">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{local:Localize TaskSettings_HdrLegend}"
                                                   Opacity="0.75" FontSize="11" TextWrapping="Wrap" MaxWidth="560"
                                                   HorizontalAlignment="Left"
                                                   AutomationProperties.Name="HDR tone mapping legend"/>
                                        <TextBlock Text="{local:Localize TaskSettings_HdrPreview}" FontWeight="SemiBold"/>
                                        <Image Source="{Binding HdrPreviewBitmap}"
                                               Width="440" Height="96"
                                               Stretch="Fill"
                                               HorizontalAlignment="Left"
                                               AutomationProperties.Name="HDR Tone Mapping Preview"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{local:Localize TaskSettings_HdrPhotoPreview}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{local:Localize TaskSettings_HdrPhotoLegend}"
                                                   Opacity="0.75" FontSize="11" TextWrapping="Wrap" MaxWidth="720"
                                                   HorizontalAlignment="Left"
                                                   AutomationProperties.Name="HDR photo tone mapping legend"/>
                                        <Grid ColumnDefinitions="Auto, 16, *" Margin="0,4,0,0">
                                            <!-- Pinned: the full HDR content through the recommended curve -->
                                            <StackPanel Grid.Column="0" Width="600" Spacing="6">
                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                        CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left">
                                                    <Image Source="{Binding HdrPhotoHable}" Width="600" Height="300" Stretch="UniformToFill"
                                                           AutomationProperties.Name="HDR photo with the recommended curve"/>
                                                </Border>
                                                <TextBlock Text="{local:Localize TaskSettings_HdrPhotoSource}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                                <Button Content="{local:Localize TaskSettings_HdrOpenPreview}"
                                                        Command="{Binding OpenHdrPhotoCommand}"
                                                        Margin="0,2,0,0"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="Open HDR preview in an external viewer"/>
                                                <TextBlock Text="{local:Localize TaskSettings_HdrOpenPreviewHint}"
                                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- Comparison: the remaining methods, scrolled -->
                                            <ScrollViewer Grid.Column="2" Classes="hdr-scroll" Height="344"
                                                          VerticalScrollBarVisibility="Visible"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Spacing="10">
                                                <StackPanel Spacing="4">
                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                            CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Image Source="{Binding HdrPhotoNone}" Height="300" Stretch="Uniform" HorizontalAlignment="Stretch"
                                                               AutomationProperties.Name="HDR photo without conversion"/>
                                                    </Border>
                                                    <TextBlock Text="{local:Localize HdrToneMappingMode_None}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                            CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Image Source="{Binding HdrPhotoReinhard}" Height="300" Stretch="Uniform" HorizontalAlignment="Stretch"
                                                               AutomationProperties.Name="HDR photo with Reinhard curve"/>
                                                    </Border>
                                                    <TextBlock Text="{local:Localize HdrToneMappingMode_TonemapReinhard}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                            CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Image Source="{Binding HdrPhotoAces}" Height="300" Stretch="Uniform" HorizontalAlignment="Stretch"
                                                               AutomationProperties.Name="HDR photo with ACES curve"/>
                                                    </Border>
                                                    <TextBlock Text="{local:Localize HdrToneMappingMode_TonemapAces}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                            CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Image Source="{Binding HdrPhotoBt2446C}" Height="300" Stretch="Uniform" HorizontalAlignment="Stretch"
                                                               AutomationProperties.Name="HDR photo with BT.2446 C curve"/>
                                                    </Border>
                                                    <TextBlock Text="{local:Localize HdrToneMappingMode_TonemapBt2446C}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Effects Tab -->
            <TabItem Header="{local:Localize TaskImage_TabEffects}">
                <Grid RowDefinitions="Auto, *" Margin="8">
                    <!-- Top Toolbar -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="{local:Localize TaskImage_Preset}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ImageEffects.Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding ImageEffects.ImportEffectsCommand}" Content="{local:Localize TaskImage_Import}" AutomationProperties.Name="Import Image Effects Preset"/>
                                <Button Command="{Binding ImageEffects.SavePresetCommand}" Content="{local:Localize TaskImage_Export}" AutomationProperties.Name="Export Image Effects Preset"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content -->
                    <Grid Grid.Row="1" ColumnDefinitions="1.1*, 16, 1.1*, 16, 1.3*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Effects List -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Row="0" Text="{local:Localize TaskImage_ActiveEffects}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                <ListBox ItemsSource="{Binding ImageEffects.Effects}" SelectedItem="{Binding ImageEffects.SelectedEffect}" Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Active Effects List">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="imagefx:ImageEffect">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="{local:Localize TaskImage_AddEffect}" Command="{Binding ImageEffects.OpenEffectBrowserDialogCommand}" AutomationProperties.Name="Add Effect Browser"/>
                                <Button Command="{Binding ImageEffects.RemoveEffectCommand}" Content="{local:Localize TaskImage_RemoveEffect}" AutomationProperties.Name="Remove Selected Effect"/>
                            </StackPanel>
                        </Grid>

                        <!-- Properties -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="{local:Localize TaskImage_Properties}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="8">
                                <controls:PropertyGrid x:Name="EffectPropertyGrid" SelectedObject="{Binding ImageEffects.SelectedEffect}" AutomationProperties.Name="Effect Properties"/>
                            </Border>
                        </Grid>

                        <!-- Preview -->
                        <Grid Grid.Column="4" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="{local:Localize TaskImage_Preview}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" MinHeight="260">
                                <Image Source="{Binding ImageEffects.PreviewBitmap}" Stretch="Uniform" Margin="10" AutomationProperties.Name="Effect Preview"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
