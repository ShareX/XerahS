<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:vm="using:XerahS.UI.ViewModels"
                xmlns:controls="using:XerahS.UI.Controls"
                mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
                x:Class="XerahS.UI.Views.DestinationSettingsView"
                x:DataType="vm:DestinationSettingsViewModel">

    <Grid ColumnDefinitions="240, *"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <!-- Category Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Text="Categories" FontWeight="SemiBold"/>
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent"
                         AutomationProperties.Name="Destination Categories">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryViewModel">
                            <TextBlock Text="{Binding Name}" Margin="0,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Routing" FontWeight="SemiBold"/>
                <Button Content="File type overrides"
                        Command="{Binding OpenOverridesCommand}"
                        HorizontalAlignment="Stretch"
                        Classes.accent="{Binding ShowOverrides}"
                        ToolTip.Tip="Send every file with an extension to one uploader, whether it is uploaded as text or as a file"
                        AutomationProperties.Name="File type overrides"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="24" IsVisible="{Binding !ShowOverrides}">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, 16, Auto" Margin="0,0,0,24">
                <TextBlock Grid.Column="0" Text="{Binding SelectedCategory.Name}" 
                           FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Import ShareX Config"
                            Command="{Binding ImportShareXConfigCommand}"
                            IsVisible="{Binding ShowImportShareXConfig}"
                            ToolTip.Tip="Import legacy ShareX UploadersConfig.json and export custom uploaders to Plugins as .sxcu files"
                            AutomationProperties.Name="Import ShareX Config"/>
                    <Button Content="Plugins Folder"
                            Command="{Binding OpenPluginsFolderCommand}"
                            ToolTip.Tip="Open the plugins folder"
                            AutomationProperties.Name="Open Plugins Folder"/>
                    <Button Content="Install Plugin"
                            Command="{Binding OpenPluginInstallerCommand}"
                            ToolTip.Tip="Install community plugins or import a local .xsdp package"
                            AutomationProperties.Name="Install Plugin"/>
                    <Button Content="Add Custom Uploader"
                            Command="{Binding AddCustomUploaderCommand}"
                            ToolTip.Tip="Create a new custom uploader (.sxcu)"
                            AutomationProperties.Name="Add Custom Uploader"/>
                    <Button Content="Add from Catalog"
                            Command="{Binding SelectedCategory.AddFromCatalogCommand}"
                            Classes="accent"
                            AutomationProperties.Name="Add Destination from Catalog"/>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" ColumnDefinitions="260, 16, *">
                
                <!-- Instance List -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="0">
                    <ListBox ItemsSource="{Binding SelectedCategory.Instances}"
                             SelectedItem="{Binding SelectedCategory.SelectedInstance}"
                             Background="Transparent"
                             AutomationProperties.Name="Destination Instances">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UploaderInstanceViewModel">
                                <Grid ColumnDefinitions="Auto, 12, *, 8, Auto" Margin="4">
                                    <Path Grid.Column="0" 
                                          Data="M12,0A12,12,0,1,0,24,12,12,12,0,0,0,12,0ZM10.8,18.6L4.2,12l1.68-1.68L10.8,15.24l7.32-7.32L19.8,9.6Z"
                                          Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                          Width="12" Height="12"
                                          IsVisible="{Binding IsDefault}"
                                          VerticalAlignment="Center"/>
                                          
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileTypeScopeDisplay}" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Button Grid.Column="4" Content="..." Padding="8,4"
                                            AutomationProperties.Name="Instance Options">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Set as Default" 
                                                          Command="{Binding $parent[ListBox].DataContext.SelectedCategory.SetAsDefaultCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Duplicate" 
                                                          Command="{Binding $parent[ListBox].DataContext.SelectedCategory.DuplicateInstanceCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Export .xsdc"
                                                          Command="{Binding $parent[ListBox].DataContext.ExportDestinationConfigCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Remove" 
                                                          Command="{Binding $parent[ListBox].DataContext.SelectedCategory.RemoveInstanceCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Configuration Panel -->
                <Border Grid.Column="2" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="24"
                        IsVisible="{Binding SelectedCategory.SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer>
                        <StackPanel Spacing="24" Margin="0,0,16,0">
                            
                            <!-- Verification Status -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedCategory.SelectedInstance.HasVerificationWarning}">
                                <Border Classes="status-warning"
                                        BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding SelectedCategory.SelectedInstance.HasVerificationWarning}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding SelectedCategory.SelectedInstance.VerificationMessage}"
                                                   Classes="status-warning"
                                                   FontWeight="Medium"/>
                                        <Expander Header="Details">
                                            <ItemsControl ItemsSource="{Binding SelectedCategory.SelectedInstance.VerificationIssues}"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                             <!-- Error Status -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedCategory.SelectedInstance.HasVerificationError}">
                                <Border Classes="status-error"
                                        BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding SelectedCategory.SelectedInstance.VerificationMessage}"
                                                   Classes="status-error"
                                                   FontWeight="SemiBold"/>
                                        <Expander Header="Fix Instructions" IsExpanded="True">
                                            <ItemsControl ItemsSource="{Binding SelectedCategory.SelectedInstance.VerificationIssues}"/>
                                        </Expander>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                            <Button Content="Clean Duplicates" 
                                                    Command="{Binding SelectedCategory.SelectedInstance.CleanDuplicatesCommand}"
                                                    AutomationProperties.Name="Clean Duplicate Files"/>
                                            <Button Content="Open Folder" 
                                                    Command="{Binding SelectedCategory.SelectedInstance.OpenPluginsFolderCommand}"
                                                    AutomationProperties.Name="Open Provider Folder"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Identity -->
                            <StackPanel Spacing="16">
                                <TextBlock Text="Identity" FontWeight="SemiBold" FontSize="16"/>
                                <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, 16, Auto, 16, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SelectedCategory.SelectedInstance.DisplayName}" 
                                             PlaceholderText="Display Name" AutomationProperties.Name="Display Name"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Provider:" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedCategory.SelectedInstance.ProviderId}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Instance ID:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SelectedCategory.SelectedInstance.InstanceId}"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ControlAltFillColorDefaultBrush}"
                                             AutomationProperties.Name="Instance ID"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding SelectedCategory.SelectedInstance.IsCustomUploaderInstance}">
                                <TextBlock Text="Definition Binding" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{Binding SelectedCategory.SelectedInstance.DefinitionSaveHelpText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, 16, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Definition file:" VerticalAlignment="Top"/>
                                    <TextBox Grid.Row="0" Grid.Column="2"
                                             Text="{Binding SelectedCategory.SelectedInstance.DefinitionFilePath}"
                                             PlaceholderText="This instance cannot be mapped back to a .sxcu source file."
                                             IsReadOnly="True"
                                             Background="{DynamicResource ControlAltFillColorDefaultBrush}"
                                             TextWrapping="Wrap"
                                             ToolTip.Tip="{Binding SelectedCategory.SelectedInstance.DefinitionBindingUnavailableReason}"
                                             AutomationProperties.Name="Custom Uploader Definition File"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Bound instance ID(s):" VerticalAlignment="Top"/>
                                    <TextBox Grid.Row="2" Grid.Column="2"
                                             Text="{Binding SelectedCategory.SelectedInstance.BoundInstanceIdsDisplay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             MinHeight="68"
                                             Background="{DynamicResource ControlAltFillColorDefaultBrush}"
                                             TextWrapping="Wrap"
                                             ToolTip.Tip="Reads XerahS.instanceIds when available, otherwise falls back to the current instance binding."
                                             AutomationProperties.Name="Bound Instance IDs"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Save Definition to Plugins"
                                            Command="{Binding SelectedCategory.SelectedInstance.SaveDefinitionToPluginsCommand}"
                                            IsEnabled="{Binding SelectedCategory.SelectedInstance.CanManageDefinition}"
                                            Classes="accent"
                                            ToolTip.Tip="{Binding SelectedCategory.SelectedInstance.DefinitionBindingUnavailableReason}"
                                            AutomationProperties.Name="Save Definition to Plugins"/>
                                    <Button Content="Save as New .sxcu"
                                            Command="{Binding SelectedCategory.SelectedInstance.SaveDefinitionAsNewCommand}"
                                            IsEnabled="{Binding SelectedCategory.SelectedInstance.CanManageDefinition}"
                                            ToolTip.Tip="{Binding SelectedCategory.SelectedInstance.DefinitionBindingUnavailableReason}"
                                            AutomationProperties.Name="Save Definition As New"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- File Type Scope -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="File Type Configuration" FontWeight="SemiBold" FontSize="16"/>
                                <ContentControl Content="{Binding SelectedCategory.SelectedInstance}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:UploaderInstanceViewModel">
                                            <controls:FileTypeSelectorControl/>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>

                            <!-- Custom Config -->
                            <StackPanel Spacing="8" IsVisible="{Binding SelectedCategory.SelectedInstance.ConfigView, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Provider Settings"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Export .xsdc"
                                            Command="{Binding ExportDestinationConfigCommand}"
                                            CommandParameter="{Binding SelectedCategory.SelectedInstance}"
                                            IsEnabled="{Binding SelectedCategory.SelectedInstance.CanExportDestinationConfig}"
                                            ToolTip.Tip="Export this destination config for mobile import"
                                            AutomationProperties.Name="Export Destination Config"/>
                                </Grid>
                                <ContentControl Content="{Binding SelectedCategory.SelectedInstance.ConfigView}"/>
                            </StackPanel>

                            <!-- Media Explorer -->
                            <StackPanel Spacing="12"
                                        IsVisible="{Binding SelectedCategory.SelectedInstance.SupportsExplorer}">
                                <Separator/>
                                <TextBlock Text="Media Explorer" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="Browse and manage files stored with this provider."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <Button Content="Browse Files"
                                        Command="{Binding SelectedCategory.SelectedInstance.OpenExplorerCommand}"
                                        IsEnabled="{Binding SelectedCategory.SelectedInstance.IsExplorerEnabled}"
                                        Classes="accent"
                                        HorizontalAlignment="Left"
                                        Padding="16,8"
                                        ToolTip.Tip="Open Media Explorer to browse remote files (requires valid credentials)"
                                        AutomationProperties.Name="Open Media Explorer"/>
                                <TextBlock Text="Configure credentials above to enable browsing."
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="11"
                                           IsVisible="{Binding !SelectedCategory.SelectedInstance.IsExplorerEnabled}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Column="2" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Spacing="16"
                            IsVisible="{Binding SelectedCategory.SelectedInstance, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="No instance selected" 
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Select an instance or add a new one to configure." 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

            </Grid>
        </Grid>

        <!-- File type overrides -->
        <ScrollViewer Grid.Column="1" Margin="24" IsVisible="{Binding ShowOverrides}">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="File type overrides" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Files with these extensions always go to the uploader chosen here, whether they are uploaded as text or as files, and before the workflow's destination and each uploader's file type settings. An uploader you pick for one upload still wins. If the chosen uploader fails, the upload fails rather than going somewhere else."/>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="No overrides yet. Files follow each category's destinations."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding !Overrides.HasRows}"/>
                        <ItemsControl ItemsSource="{Binding Overrides.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTypeOverrideRowViewModel">
                                    <Grid ColumnDefinitions="110, 12, *, 12, Auto" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" Text="{Binding ExtensionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Targets}"
                                                  SelectedItem="{Binding Target}"
                                                  PlaceholderText="(uploader removed: choose another)"
                                                  AutomationProperties.Name="{Binding ExtensionLabel, StringFormat='Uploader for {0} files'}"/>
                                        <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveCommand}"
                                                AutomationProperties.Name="{Binding ExtensionLabel, StringFormat='Remove the override for {0}'}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator/>
                        <TextBlock Text="Add an override" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="110, 12, *, 12, Auto">
                            <TextBox Grid.Column="0" Text="{Binding Overrides.NewExtension}" PlaceholderText="md"
                                     AutomationProperties.Name="Extension"/>
                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Overrides.Targets}"
                                      SelectedItem="{Binding Overrides.NewTarget}"
                                      AutomationProperties.Name="Uploader for the new extension"/>
                            <Button Grid.Column="4" Content="Add" Classes="accent" Command="{Binding Overrides.AddCommand}"
                                    AutomationProperties.Name="Add override"/>
                        </Grid>
                        <TextBlock Text="{Binding Overrides.Message}" TextWrapping="Wrap"
                                   IsVisible="{Binding Overrides.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:PageView>
