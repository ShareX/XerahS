<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:local="using:XerahS.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="40"
             x:Class="XerahS.UI.Views.Controls.HotkeySelectionControl"
             x:DataType="vm:HotkeyItemViewModel">
    <Border Classes="hotkeySurface"
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="8,4"
            Classes.highlighted="{Binding IsHighlighted}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Status Icon -->
            <Ellipse Grid.Column="0" 
                     Width="10" Height="10" 
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Fill="{Binding Status, Converter={x:Static vm:HotkeyStatusColorConverter.Instance}}"/>

            <!-- Nav Label -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="3"
                    Padding="4,2"
                    Margin="0,0,4,0"
                    IsVisible="{Binding NavLabelVisible}"
                    VerticalAlignment="Center">
                <TextBlock Text="{local:Localize HotkeySelection_Nav}" 
                           Classes="on-accent"
                           FontSize="10" 
                           FontWeight="Bold"/>
            </Border>

            <!-- Tray Label -->
            <Border Grid.Column="2"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="3"
                    Padding="4,2"
                    Margin="0,0,8,0"
                    IsVisible="{Binding TrayLabelVisible}"
                    VerticalAlignment="Center">
                <TextBlock Text="{local:Localize HotkeySelection_Tray}" 
                           Classes="on-accent"
                           FontSize="10" 
                           FontWeight="Bold"/>
            </Border>
            
            <!-- Task Description -->
            <Border Grid.Column="3" 
                    HorizontalAlignment="Stretch"
                    Padding="5,2">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Description}" 
                                   FontWeight="{Binding $parent[ListBoxItem].IsSelected, Converter={x:Static vm:BoolToFontWeightConverter.Instance}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding JobDescription}"
                                   IsVisible="{Binding ShowJobDescription}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Hotkey Capture Button -->
            <Border Grid.Column="4"
                    Classes="hotkeyCaptureSurface"
                    CornerRadius="3" 
                    Margin="10,0"
                    MinWidth="100">
                <Button x:Name="HotkeyButton"
                        Content="{Binding KeyString}"
                        MinWidth="300"
                        Background="Transparent"
                        BorderThickness="0"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="10,4"
                        Focusable="True"
                        Cursor="Hand"
                        Click="HotkeyButton_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
