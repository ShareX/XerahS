<views:OverlayWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:views="using:XerahS.UI.Views"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="XerahS.UI.Views.ToastWindow"
        x:DataType="vm:ToastViewModel"
        Title="Toast"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Cursor="Hand"
        AutomationProperties.Name="Notification Toast">

    <Window.Styles>
        <Style Selector="Button.toast-action">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#CC383838"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toast-action /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CC383838"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
        </Style>
        <Style Selector="Button.toast-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.toast-action:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Border.output-chip TextBlock">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
        </Style>
        <Style Selector="Border.output-chip.warning TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="1"
            BoxShadow="0 4 12 0 #40000000">
        
        <Grid>
            <!-- Image display (when available) -->
            <Image Source="{Binding Image}"
                   IsVisible="{Binding HasImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Notification Image"/>
            
            <!-- Text display (when no image or as overlay) -->
            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding !HasImage}"
                        Margin="{Binding TextContentMargin}">
                
                <!-- Title -->
                <TextBlock Text="{Binding Title}"
                           IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                
                <!-- Main text -->
                <TextBlock Text="{Binding Text}"
                           Theme="{StaticResource BodyTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="200"/>
            </StackPanel>
            
            <!-- URL overlay when hovering over image -->
            <Border Background="{DynamicResource XerahS.Brush.Overlay.Soft}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    IsVisible="{Binding HasHeaderText}"
                    x:Name="UrlOverlay"
                    Opacity="0">
                <TextBlock Text="{Binding HeaderText}"
                           Foreground="{DynamicResource XerahS.Brush.Overlay.Foreground}"
                           FontSize="11"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- Output chip: where the result ended up (Online / Local / Not uploaded / Clipboard).
                 Fades out while the hover toolbar is showing; never moves. -->
            <Border x:Name="OutputChip"
                    Classes="output-chip"
                    Classes.warning="{Binding IsOutputChipWarning}"
                    IsVisible="{Binding HasOutputChip}"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,8"
                    Height="22"
                    Padding="8,0"
                    CornerRadius="11"
                    Background="#E61B1B1B"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    AutomationProperties.Name="{Binding OutputChipAccessibleName}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="IconGlyph"
                               Text="{Binding OutputChipIcon}"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OutputChipLabel}"
                               IsVisible="{Binding ShowOutputChipLabel}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Transparent overlay for shared HistoryItemMenuFlyout (context menu); fills grid so right-click works -->
            <Border Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    x:Name="FlyoutHost"
                    ContextFlyout="{StaticResource HistoryItemMenuFlyout}"/>

            <!-- Action buttons shown on hover (same toolbar as ShareX's notification window) -->
            <Border x:Name="ActionsPanel"
                    Padding="6"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    CornerRadius="0,0,5,5"
                    Background="#C01B1B1B"
                    IsVisible="{Binding HasActionButtons}"
                    IsHitTestVisible="False"
                    Opacity="0">
                <ItemsControl ItemsSource="{Binding ActionButtons}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToastActionButtonViewModel">
                            <Button Classes="toast-action"
                                    Command="{Binding Command}"
                                    Width="{Binding $parent[views:ToastWindow].((vm:ToastViewModel)DataContext).ActionButtonSize}"
                                    Height="{Binding $parent[views:ToastWindow].((vm:ToastViewModel)DataContext).ActionButtonSize}"
                                    CornerRadius="{Binding $parent[views:ToastWindow].((vm:ToastViewModel)DataContext).ActionButtonCornerRadius}"
                                    ToolTip.Tip="{Binding Label}"
                                    ToolTip.Placement="Top"
                                    ToolTip.ShowDelay="400"
                                    AutomationProperties.Name="{Binding Label}">
                                <TextBlock Classes="IconGlyph"
                                           Text="{Binding Icon}"
                                           FontSize="{Binding $parent[views:ToastWindow].((vm:ToastViewModel)DataContext).ActionButtonIconSize}"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</views:OverlayWindow>
