<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:vm="using:XerahS.UI.ViewModels"
                mc:Ignorable="d" d:DesignWidth="1126" d:DesignHeight="700"
                x:Class="XerahS.UI.Views.WorkflowsView"
                x:DataType="vm:WorkflowsViewModel">
    <Grid ColumnDefinitions="220,*">
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0" Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                <TextBlock Text="Workflows" FontWeight="SemiBold"/>
                <Button Grid.Row="1" Content="Add workflow" Command="{Binding AddWorkflowCommand}"
                        AutomationProperties.Name="Add New Workflow"/>
                <ListBox x:Name="WorkflowList" Grid.Row="2" Background="Transparent"
                         ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow}"
                         AutomationProperties.Name="Workflows List">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotkeyItemViewModel">
                            <StackPanel Spacing="4" Margin="0,4">
                                <TextBlock Text="{Binding Description}" FontWeight="Medium" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={x:Static vm:HotkeyStatusColorConverter.Instance}}"
                                             ToolTip.Tip="{Binding Status}"
                                             AutomationProperties.Name="{Binding Status, StringFormat='Hotkey status: {0}'}"/>
                                    <TextBlock Text="{Binding KeyString}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Navigation" FontSize="11" IsVisible="{Binding NavLabelVisible}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="Tray" FontSize="11" IsVisible="{Binding TrayLabelVisible}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3" Content="Reset workflows…" Command="{Binding ResetCommand}"
                        AutomationProperties.Name="Reset Workflows"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding SelectedWorkflow.Description}" FontSize="26" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Options" AutomationProperties.Name="Workflow Options"
                        IsEnabled="{Binding SelectedWorkflow, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"/>
                            <MenuItem Header="{Binding PinButtonText}" Command="{Binding TogglePinCommand}"/>
                            <Separator/>
                            <MenuItem Header="Move up" Command="{Binding MoveUpCommand}"/>
                            <MenuItem Header="Move down" Command="{Binding MoveDownCommand}"/>
                            <Separator/>
                            <MenuItem Header="Remove" Command="{Binding RemoveWorkflowCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Content="Retry" Command="{Binding RetrySaveCommand}" IsVisible="{Binding HasSaveError}"
                        AutomationProperties.Name="Retry Saving Workflow"/>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    IsVisible="{Binding SelectedEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <views:WorkflowEditorView x:Name="InlineWorkflowEditor" DataContext="{Binding SelectedEditor}"/>
            </Border>
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                        IsVisible="{Binding SelectedEditor, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="No workflows yet" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Add a workflow to choose its task, hotkey and settings." TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</views:PageView>
