<UserControl xmlns:local="using:XerahS.UI.Markup"
           xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XerahS.UI.ViewModels"
        x:Class="XerahS.UI.Views.Dialogs.OpenImageChoiceDialog"
        x:DataType="vm:OpenImageChoiceViewModel"
        MinWidth="420" MaxWidth="520">
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            Padding="16">
        <StackPanel Spacing="12">
            <TextBlock Text="{local:Localize OpenImageChoice_AlreadyOpen}"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{local:Localize OpenImageChoice_Prompt}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{local:Localize OpenImageChoice_AddAsShape}" Command="{Binding AddAsShapeCommand}"/>
                <Button Content="{local:Localize OpenImageChoice_ReplaceImage}" Command="{Binding ReplaceCommand}" Classes="accent"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
