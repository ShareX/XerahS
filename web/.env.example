APP_ENV=development
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PASSKEYS_ENABLED=false
XERAHS_DESKTOP_OAUTH_CLIENT_ID=
# Neon project xerahs-cloud (`neon link` / `neon env pull` write these).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32+ random bytes, e.g. `openssl rand -base64 32`. Signs Better Auth cookies.
BETTER_AUTH_SECRET=
# Verification and password-reset email (required in staging/production).
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_ENTITLED_LEGACY_PRICES=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_EXPECT_LIVEMODE=false
STRIPE_TAX_ENABLED=false
R2_LEDGER_ACCOUNT_ID=
R2_LEDGER_BUCKET=
R2_LEDGER_ACCESS_KEY_ID=
R2_LEDGER_SECRET_ACCESS_KEY=
R2_LEDGER_READ_ACCESS_KEY_ID=
R2_LEDGER_READ_SECRET_ACCESS_KEY=
LEDGER_HMAC_ACTIVE_VERSION=v1
LEDGER_HMAC_SECRET_V1=
LEDGER_HMAC_SECRETS_JSON=
IDENTITY_HMAC_SECRET_V1=
RECOVERY_CODE_PEPPER_V1=
LEDGER_USE_LOCAL_FAKE=true
CRON_SECRET=
RESTORE_CONFIRM_CLOSED_TRAFFIC=
