{
  "name": "@xerahs/gallery-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "lint": "node tooling/eslint/run.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "r2:configure": "node scripts/configure-cloudflare-r2.mjs",
    "r2:verify": "node scripts/verify-cloudflare-r2.mjs",
    "scheduler:types": "wrangler types --include-runtime false --config infrastructure/cloudflare/scheduler/wrangler.jsonc infrastructure/cloudflare/scheduler/worker-configuration.d.ts",
    "scheduler:typecheck": "tsc --project infrastructure/cloudflare/scheduler/tsconfig.json",
    "scheduler:dry-run": "wrangler deploy --dry-run --env staging --config infrastructure/cloudflare/scheduler/wrangler.jsonc",
    "scheduler:dry-run:production": "wrangler deploy --dry-run --env production --config infrastructure/cloudflare/scheduler/wrangler.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@neon/config": "1.8.3",
    "@neon/env": "1.4.8",
    "@neon/functions": "0.11.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.7",
    "hono": "4.13.11",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "next": "16.4.3",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "27.4.0",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.125.0"
  }
}
