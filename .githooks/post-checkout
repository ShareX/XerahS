#!/usr/bin/env sh

set -e

script_dir="$(cd "$(dirname "$0")" && pwd)"

# Create local agent skill links if missing (never fails the hook).
if [ -f "$script_dir/../scripts/link-agent-skills.sh" ]; then
  bash "$script_dir/../scripts/link-agent-skills.sh" --quiet || true
fi

if [ -x "$script_dir/sync-imageeditor-head" ]; then
  exec "$script_dir/sync-imageeditor-head"
elif command -v sh >/dev/null 2>&1; then
  exec sh "$script_dir/sync-imageeditor-head"
fi

exit 0
